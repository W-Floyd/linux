# fogona bringup fragment for the 6.14 khaje tree.
CONFIG_SM_GCC_6225=y
# dispcc and gpucc both OFF, and this time for a reason read out of the DT
# rather than inferred from a symptom.
#
# dispcc: the ONLY consumers of &dispcc in sm6225.dtsi are `mdss` and its
# children, and mdss is `status = "disabled"`. So nothing enabled needs dispcc,
# and enabling it is pure cost: disp_cc_sm6115_probe() calls
# clk_alpha_pll_configure() on disp_cc_pll0, which is the PLL feeding the DSI
# link ABL left running behind our simple-framebuffer. Reconfiguring a live
# display PLL kills scanout, which is the "Tux, then black" we keep seeing --
# and no amount of clk_ignore_unused can prevent it, because this happens in
# probe, not in the unused-clock cleanup.
#
# gpucc: its only consumers are `gpu`, `gmu_wrapper` and `adreno_smmu`, all
# three of which the board DTS now disables. Keeping gpucc out removes the
# arm-smmu 59a0000.iommu -110 failure and the "supplier <addr>.clock-controller
# not ready" line.
#
# Correcting the note that used to live here: that line said UFS was deferring
# behind an IOMMU starved of gpucc clocks. It was not. ufs_mem_hc's iommu is
# `apps_smmu@c600000`, which has NO clocks property at all -- only
# adreno_smmu@59a0000 is clocked, and nothing on the storage path goes through
# it. UFS defers behind ufs_mem_phy, which is a different chain entirely.
# CONFIG_SM_DISPCC_6225 is not set
# CONFIG_SM_GPUCC_6225 is not set
CONFIG_PINCTRL_SM6115=y
CONFIG_INTERCONNECT_QCOM_SM6225=y

# RPM: khaje's rails are pm6125 LDOs behind SMD/RPM (Cortex-M3 RPM, not RPMh)
CONFIG_QCOM_SMEM=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
# Not CONFIG_QCOM_RPMCC -- that symbol does not exist in this tree and was
# silently ignored by olddefconfig. clk-smd-rpm.o is built by
# CONFIG_QCOM_CLK_SMD_RPM (drivers/clk/qcom/Makefile:72).
CONFIG_QCOM_CLK_SMD_RPM=y

# PMIC over SPMI: pon -> pwrkey/resin (power + volume-down)
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_QCOM_MPM=y

# storage
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# PHY_QCOM_QMP is a *menuconfig* umbrella, not a driver. Setting it =y builds
# nothing: the actual drivers are its sub-symbols, and this GKI-derived
# defconfig pins them to =m -- which our initramfs (still 6.1-built) has no
# modules for. That is why ufs_mem_phy stayed UNBOUND and ufs_mem_hc deferred
# forever on devm_phy_get(): the driver was never loaded at all.
#
# The same trap hides the USB failure, but the symbol is NOT PHY_QCOM_USB_HS --
# that is phy-qcom-usb-hs.c, the old ULPI driver for "qcom,usb-hs-phy", and it
# has nothing to do with this SoC. Our usb_hsphy@1613000 is
# "qcom,usb-snps-hs-7nm-phy", matched by phy-qcom-snps-femto-v2.c, whose symbol
# is PHY_QCOM_USB_SNPS_FEMTO_V2 -- also =m, so the phy never bound, dwc3 never
# got a usb2-phy, and /sys/class/udc stayed empty.
#
# Note this is NOT mainline sm6115's node: sm6115.dtsi declares usb_hsphy as
# "qcom,sm6115-qusb2-phy" (phy-qcom-qusb2.c, supplies vdd/vdda-pll/
# vdda-phy-dpdm), which is why sm6115p-lenovo-j606f.dts uses those property
# names. The khaje dtsi picked the femto-v2 node instead, which wants
# vdda-pll/vdda33/vdda18 -- the names this board DTS already uses. Do not
# "fix" them to j606f's; they belong to a different driver.
#
# Both must be built IN, not modular, until an initramfs is built against this
# kernel.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# usb gadget over configfs, so the initramfs can bring up a network console
# once a UDC finally exists. dwc3 is already DUAL_ROLE=y in the base config,
# which covers peripheral mode -- USB_DWC3_GADGET is not needed.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# console on ABL's splash framebuffer
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# A73 erratum: CNTVCT can return a corrupted value without this
CONFIG_ARM64_ERRATUM_858921=y

# keep the boot debuggable
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# Tiny fbcon font so the kernel log fits: 8x16 gives 90x100 chars on this
# 720x1600 panel, MINI4x6 gives 180x266. FONT_MINI_4x6 is only selectable when
# CONFIG_FONTS=y (it "depends on !SPARC && FONTS"), and keeping 8x16 built in
# means fbcon still has a fallback.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_6x10=y

# --- GUI (phosh) on ABL's framebuffer -------------------------------------
# phosh needs a DRM device; simplefb does not provide one, and CONFIG_DRM was
# =m in the base config with no loadable modules to match, so /dev/dri was
# empty. simpledrm binds the SAME DT "simple-framebuffer" node we already use
# and exposes it as /dev/dri/card0, which wlroots/phoc can drive with
# llvmpipe (the A610 is disabled -- see the adreno note in the board DTS).
#
# FB_SIMPLE must go: simplefb and simpledrm both match compatible =
# "simple-framebuffer", so leaving both built in is a race for the same node.
# DRM_FBDEV_EMULATION keeps fbcon working on top of simpledrm, so the kernel
# log stays on the panel -- losing that would blind the whole bringup.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FB_SIMPLE is not set

# --- low-hanging fruit ----------------------------------------------------
# Two systemd units failed on the first phosh boot, both for want of kernel
# support rather than anything device-specific:
#   postmarketos-zram-swap.service  -> CONFIG_ZRAM
#   nftables.service                -> CONFIG_NF_TABLES
# Neither is in `pmbootstrap kconfig check`'s required set, so the check passes
# without them -- the evidence was the failing units, not the checker.
CONFIG_ZRAM=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
# NFT_REJECT cannot be =y while IPV6=m. Its Kconfig line is
#   depends on !NF_TABLES_INET || (IPV6!=m || m)
# so with NF_TABLES_INET=y and IPV6=m the whole expression evaluates to m,
# which *caps* NFT_REJECT at m no matter what the .config says -- olddefconfig
# silently demotes it back. IPV6=m was its own bug anyway: a modular IPv6 never
# loaded, so the device had no IPv6 at all.
CONFIG_IPV6=y
# Same shape: DM_CRYPT is capped by BLK_DEV_DM, which was =m.
CONFIG_BLK_DEV_DM=y

# The rest of `pmbootstrap kconfig check`. Everything here must be =y, not =m:
# we boot a single Image with no matching modules on disk, so a module is the
# same as absent -- which is exactly the trap that hid the UFS and USB phys.
CONFIG_NLS_ASCII=y
CONFIG_SYN_COOKIES=y
CONFIG_UEVENT_HELPER=y
CONFIG_NULL_TTY=y
CONFIG_PSI=y
CONFIG_UDMABUF=y
CONFIG_SECURITY_PATH=y
CONFIG_BPF_LSM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_XTS=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_REDUCED is not set
#
# Deliberately NOT taken: CONFIG_DEBUG_INFO_BTF / _BTF_MODULES. They need
# pahole and add a large chunk of build time to every iteration, which is the
# wrong trade while the loop is still the bottleneck. Revisit before any
# upstreaming or if bpftrace is wanted on-device.
