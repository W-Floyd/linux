# fogona bringup fragment for the 6.14 khaje tree.
CONFIG_SM_GCC_6225=y
# gpucc OFF, dispcc now ON -- and the reason dispcc changed is that its premise
# did, not that the old reasoning was wrong.
#
# dispcc used to be pure cost. The only consumers of &dispcc in sm6225.dtsi are
# `mdss` and its children, and mdss was `status = "disabled"`, so nothing
# enabled needed it -- while disp_cc_sm6115_probe() calls
# clk_alpha_pll_configure() on disp_cc_pll0, the PLL feeding the DSI link ABL
# left running behind our simple-framebuffer. Reconfiguring a live display PLL
# kills scanout, and no amount of clk_ignore_unused prevents it, because it
# happens in probe rather than in the unused-clock cleanup. That is the "Tux,
# then black" this bringup chased for a long time.
#
# The board DTS now enables mdss, DSI0 and the PHY, so dispcc has a real
# consumer and there is a driver to put the panel back up after the PLL moves.
# Losing ABL's scanout is now the intended trade, not an accident. Note this
# means a failure in the msm/panel path is a black screen with no console
# fallback -- debug it over USB (SSH on usb0), which survives it.
#
# Without this the display cannot come up at all: `mdss` fails probe with -110
# because there is no disp_cc clock provider, and no amount of device-tree work
# changes that. The DT node carries no status property, so it is easy to check
# the node and wrongly conclude dispcc is fine while the driver is absent.
#
# gpucc: its only consumers are `gpu`, `gmu_wrapper` and `adreno_smmu`, all
# three of which the board DTS now disables. Keeping gpucc out removes the
# arm-smmu 59a0000.iommu -110 failure and the "supplier <addr>.clock-controller
# not ready" line.
#
# Correcting the note that used to live here: that line said UFS was deferring
# behind an IOMMU starved of gpucc clocks. It was not. ufs_mem_hc's iommu is
# `apps_smmu@c600000`, which has NO clocks property at all -- only
# adreno_smmu@59a0000 is clocked, and nothing on the storage path goes through
# it. UFS defers behind ufs_mem_phy, which is a different chain entirely.
CONFIG_SM_DISPCC_6225=y
# gpucc must be ON whenever &adreno_smmu is enabled, even with &gpu and
# &gmu_wrapper disabled. The SMMU node consumes GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK
# and gpucc is its only provider, so with the driver absent there is no
# provider for a clock the DT says the SMMU needs.
#
# Turned on 2026-09-11 while investigating the first mainline boot, which hung
# at the Moto logo. This branch carried `&adreno_smmu = okay` with gpucc off --
# a combination that has never existed on the 6.14 tree, where gpucc is =y
# whenever the SMMU is enabled. It also sits exactly where this board's only
# previously known logo hang lived: arm_smmu_device_probe() enables its clock
# bulk and *then* reads ARM_SMMU_GR0_ID0, and an unclocked read there hangs the
# bus with no diagnostic at all.
#
# CONFIRMED on hardware later the same day. The board boots, and
# `sm6225-gpucc 5990000.clock-controller` comes up and drives 596a000.gmu.
# It turned out to be load-bearing well beyond the SMMU: with &gpu and
# &gmu_wrapper enabled the Adreno 610 renders a phosh session (a630_sqe.fw
# loaded, zero `gpu fault` / `hangcheck` / `pll0 failed`), which it cannot do
# without its clock controller. The fallback written here -- disabling
# &adreno_smmu outright to separate "SMMU needs its clock" from "SMMU should
# not be on yet" -- was never needed.
CONFIG_SM_GPUCC_6225=y
CONFIG_PINCTRL_SM6115=y
CONFIG_INTERCONNECT_QCOM_SM6225=y

# RPM: khaje's rails are pm6125 LDOs behind SMD/RPM (Cortex-M3 RPM, not RPMh)
CONFIG_QCOM_SMEM=y
# Publishes the unit info block the modem needs for RF (SMEM item 134);
# built in so it is there before the modem's firmware loads.
CONFIG_QCOM_MMI_UNIT_INFO=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
# Not CONFIG_QCOM_RPMCC -- that symbol does not exist in this tree and was
# silently ignored by olddefconfig. clk-smd-rpm.o is built by
# CONFIG_QCOM_CLK_SMD_RPM (drivers/clk/qcom/Makefile:72).
CONFIG_QCOM_CLK_SMD_RPM=y

# PMIC over SPMI: pon -> pwrkey/resin (power + volume-down)
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_QCOM_MPM=y

# storage
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# PHY_QCOM_QMP is a *menuconfig* umbrella, not a driver. Setting it =y builds
# nothing: the actual drivers are its sub-symbols, and this GKI-derived
# defconfig pins them to =m -- which our initramfs (still 6.1-built) has no
# modules for. That is why ufs_mem_phy stayed UNBOUND and ufs_mem_hc deferred
# forever on devm_phy_get(): the driver was never loaded at all.
#
# The same trap hides the USB failure, but the symbol is NOT PHY_QCOM_USB_HS --
# that is phy-qcom-usb-hs.c, the old ULPI driver for "qcom,usb-hs-phy", and it
# has nothing to do with this SoC. Our usb_hsphy@1613000 is
# "qcom,usb-snps-hs-7nm-phy", matched by phy-qcom-snps-femto-v2.c, whose symbol
# is PHY_QCOM_USB_SNPS_FEMTO_V2 -- also =m, so the phy never bound, dwc3 never
# got a usb2-phy, and /sys/class/udc stayed empty.
#
# Note this is NOT mainline sm6115's node: sm6115.dtsi declares usb_hsphy as
# "qcom,sm6115-qusb2-phy" (phy-qcom-qusb2.c, supplies vdd/vdda-pll/
# vdda-phy-dpdm), which is why sm6115p-lenovo-j606f.dts uses those property
# names. The khaje dtsi picked the femto-v2 node instead, which wants
# vdda-pll/vdda33/vdda18 -- the names this board DTS already uses. Do not
# "fix" them to j606f's; they belong to a different driver.
#
# Both must be built IN, not modular, until an initramfs is built against this
# kernel.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# usb gadget over configfs, so the initramfs can bring up a network console
# once a UDC finally exists. dwc3 is already DUAL_ROLE=y in the base config,
# which covers peripheral mode -- USB_DWC3_GADGET is not needed.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# console on ABL's splash framebuffer
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# A73 erratum: CNTVCT can return a corrupted value without this
CONFIG_ARM64_ERRATUM_858921=y

# keep the boot debuggable
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# Tiny fbcon font so the kernel log fits: 8x16 gives 90x100 chars on this
# 720x1600 panel, MINI4x6 gives 180x266. FONT_MINI_4x6 is only selectable when
# CONFIG_FONTS=y (it "depends on !SPARC && FONTS"), and keeping 8x16 built in
# means fbcon still has a fallback.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_6x10=y

# --- GUI (phosh) on ABL's framebuffer -------------------------------------
# phosh needs a DRM device; simplefb does not provide one, and CONFIG_DRM was
# =m in the base config with no loadable modules to match, so /dev/dri was
# empty. simpledrm binds the SAME DT "simple-framebuffer" node we already use
# and exposes it as /dev/dri/card0, which wlroots/phoc can drive with
# llvmpipe (the A610 is disabled -- see the adreno note in the board DTS).
#
# FB_SIMPLE must go: simplefb and simpledrm both match compatible =
# "simple-framebuffer", so leaving both built in is a race for the same node.
# DRM_FBDEV_EMULATION keeps fbcon working on top of simpledrm, so the kernel
# log stays on the panel -- losing that would blind the whole bringup.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FB_SIMPLE is not set

# --- the real display pipeline: MDSS/DPU -> DSI0 -> panel -----------------
# Both of these must be =y, and for a sharper reason than the usual "modules
# may not be on disk". driver_deferred_probe_timeout is a one-shot global timer
# that expires ~10s after initcalls. msm.ko loads from the rootfs at ~27s, by
# which point the timer is long gone, so fw_devlink stops waiting for suppliers
# and mdss fails immediately with "deferred probe timeout, ignoring dependency"
# and -110. Reloading the module afterwards does not help: the timeout does not
# come back. Measured on this board, not assumed.
#
# It also breaks a genuine cycle. dispcc takes two of its parents from
# &mdss_dsi0_phy, and the 7nm DSI PHY driver is built into msm -- so as a module
# the clock provider dispcc needs simply does not exist during initcalls.
#
# The panel additionally never autoloaded as a module at all: nothing walks the
# DSI bus to match its modalias before mdss has probed.
# DRM_MSM cannot be =y while these are =m. Both use the
# "depends on X || X=n" idiom, which evaluates to m when X=m and silently
# caps DRM_MSM at m -- olddefconfig demotes it right back with no warning.
# Same shape as the NFT_REJECT/IPV6 trap further down. Neither exists on khaje:
# sm6225.dtsi has no system-cache-controller node and no ocmem node, so turning
# them off costs nothing.
# CONFIG_QCOM_LLCC is not set
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_CHIPONE_ICNL9916_720_1600=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Nothing on this board is an NVIDIA desktop GPU. Beyond being dead weight,
# nouveau=m broke the build outright once: an interrupted make left its
# subdirectory objects half-written and the link then failed on missing
# nvkm/engine/gr objects, which looks like a kernel bug and is not one.
# CONFIG_DRM_NOUVEAU is not set

# --- low-hanging fruit ----------------------------------------------------
# Two systemd units failed on the first phosh boot, both for want of kernel
# support rather than anything device-specific:
#   postmarketos-zram-swap.service  -> CONFIG_ZRAM
#   nftables.service                -> CONFIG_NF_TABLES
# Neither is in `pmbootstrap kconfig check`'s required set, so the check passes
# without them -- the evidence was the failing units, not the checker.
CONFIG_NF_CONNTRACK=y
# NFT_REJECT cannot be =y while IPV6=m. Its Kconfig line is
#   depends on !NF_TABLES_INET || (IPV6!=m || m)
# so with NF_TABLES_INET=y and IPV6=m the whole expression evaluates to m,
# which *caps* NFT_REJECT at m no matter what the .config says -- olddefconfig
# silently demotes it back. IPV6=m was its own bug anyway: a modular IPv6 never
# loaded, so the device had no IPv6 at all.
CONFIG_IPV6=y
# Same shape: DM_CRYPT is capped by BLK_DEV_DM, which was =m.
CONFIG_BLK_DEV_DM=y

# The rest of `pmbootstrap kconfig check`. Everything here must be =y, not =m:
# we boot a single Image with no matching modules on disk, so a module is the
# same as absent -- which is exactly the trap that hid the UFS and USB phys.
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_XTS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# CONFIG_DEBUG_INFO_REDUCED is not set
#
# Deliberately NOT taken: CONFIG_DEBUG_INFO_BTF / _BTF_MODULES. They need
# pahole and add a large chunk of build time to every iteration, which is the
# wrong trade while the loop is still the bottleneck. Revisit before any
# upstreaming or if bpftrace is wanted on-device.

# --- touch: SPI SE0 -------------------------------------------------------
# Same builtin-vs-module trap as the UFS and USB phys. spi0 is "qcom,geni-spi"
# and declares GPI DMA channels, so both of these have to be built in or the
# controller never binds and the touch node has nothing to attach to.
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
# Touch is a MODULE, not builtin, and that is deliberate. The ICNL9916C keeps
# no persistent firmware, so the driver needs chipone_firmware.bin at probe
# time -- but that blob lives in the device's own vendor partition, which
# msm-firmware-loader only mounts once userspace is up. A builtin driver
# probes long before that and would fail every boot. As a module it loads
# after msm-firmware-loader.service and request_firmware() just works.
CONFIG_TOUCHSCREEN_CHIPONE_ICNL9916=m

# msm-firmware-loader prerequisites: it runs make-dynpart-mappings over the LP
# metadata in `super` to expose vendor_a as a dm-linear device, then mounts it.
# Android ships vendor as compressed EROFS (magic e2e1f5e0), so both are needed;
# dm-linear has no symbol of its own, it is part of dm-mod.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_BLK_DEV_DM=y

# Pin the kernel version string. With LOCALVERSION_AUTO the git hash lands in
# vermagic, so every commit invalidates already-built modules against a running
# kernel -- "Invalid module format" for a source tree that has not functionally
# changed. Since the touch driver is a module and gets reloaded constantly
# during bringup, a stable release string is worth more than the provenance.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-fogona"

# Type-C CC logic. The SGM7220 is a register-level TUSB320 clone (it returns
# the literal "TUSB320" signature), so the mainline extcon driver binds
# unmodified. =y rather than =m for the usual reason: it has to be bound before
# driver_deferred_probe_timeout fires, and dwc3's role switch depends on it.
CONFIG_TYPEC=y
CONFIG_EXTCON_USBC_TUSB320=y

# The CW2217 fuel gauge. =y because it is built in on the kernel that works.
# This line is load-bearing precisely because it looks redundant: the gauge has
# been bound since bringup, but the symbol was never written down here, and
# arm64 defconfig does not carry it. It survived only in whichever .config each
# build happened to start from, so the first rebuild that started from
# defconfig dropped it silently -- see the commit message.
CONFIG_BATTERY_CW221X=y

# The charger: a Southchip SC89890H at 0x6a on i2c1, the second source for the
# bq25890 position. arm64 defconfig already carries this =m, but state it here
# so fogona-config.sh verifies it rather than leaving it to be inherited -- the
# gauge above is what that gamble looks like when it is lost.
#
# Modular on purpose: this is the first bring-up of a chip variant the driver
# has never seen, so =m lets the parameters be re-tried with rmmod and insmod
# rather than a boot each time. Move it to =y once it is trusted, since a phone
# that cannot charge because a module failed to load is a bad failure mode.
CONFIG_CHARGER_BQ25890=m

# The TPS61280A boost at 0x75 on i2c1 that feeds the QET4101 PA power manager,
# and through it the 4G PA. The only RF supply the AP owns; the modem cannot
# reach it. =y: the modem starts ~35 s into boot and its RF init expects the
# supply to already be there, so this must not wait on a module load.
CONFIG_REGULATOR_TPS61280=y

# khaje's own TLMM, not bengal's. The pin tables are not interchangeable --
# khaje inserts usb2phy_ac at mux slot 2 of GPIO0, shifting everything after
# it, and GPIOs 35/36/47/48 differ. Needs the matching compatible in
# sm6225.dtsi, and two driver fixes; see the pinctrl-sm6225 commits.
CONFIG_PINCTRL_SM6225=y

# Compressed firmware, so WiFi keeps a fallback. The two ath10k files this
# device normally uses are both uncompressed -- board-2.bin is repacked on the
# handset from its own calibration blob, and firmware-5.bin is generated by the
# device package -- but linux-firmware-ath10k sits underneath them as the floor
# for a boot where the vendor partition never mounts, and it ships
# WCN3990/hw1.0/board-2.bin and firmware-5.bin as .zst and nothing else. Without
# this the fallback is unreadable and ath10k stops at "failed to fetch
# board-2.bin or board.bin", so the failure mode is no WiFi rather than
# degraded WiFi.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Speaker and earpiece amplifiers: two AW88261s on i2c2, primary MI2S.
# Needed as a module, not built in: aw88261 hard-fails probe without its ACF
# tuning container, and that file comes from the vendor partition by way of
# msm-firmware-loader -- which is userspace, and so is not mounted yet at the
# time a built-in driver would probe.
CONFIG_SND_SOC_AW88261=m

# Headset/mic codec: a WCD9370 on the LPASS RX/TX SoundWire masters, behind
# the RX/TX/VA macros. The macros and SoundWire are already =m in defconfig;
# stated so fogona-config.sh checks them. lpasscc-sm6115 provides the
# SoundWire masters' resets.
CONFIG_SND_SOC_WCD937X=m
CONFIG_SND_SOC_WCD937X_SDW=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SM_LPASSCC_6115=m

# Camera.
#
# CAMSS and CCI are already =m in arm64 defconfig, but state them here so
# fogona-config.sh verifies them rather than leaving them inherited -- the same
# gamble the fuel gauge above lost.
#
# The rear 50 MP sensor is a Samsung S5KJN1 whose upstream driver landed in
# December 2025; as far as this port can tell no in-tree board uses it yet, so
# expect to be its first. =m throughout: all of these iterate with rmmod and
# insmod and no boot, which matters most for a stack nobody has run on khaje.
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_S5KJN1=m
# The front sensor on this unit is an OV08F10, driven by ov08d10.
CONFIG_VIDEO_OV08D10=m
# The rear module's autofocus actuator, a Giantec GT9764, driven by dw9719 as
# a DW9800K.
CONFIG_VIDEO_DW9719=m
# The rear module's calibration EEPROM (focus calibration and more), read by
# go-chromatix2libcamera through nvmem.
CONFIG_EEPROM_AT24=m

# Flash and torch. The fitted part is an OCP8135/SGM3785 two-pin charge pump,
# which leds-sgm3140 already matches; it needs none of the camera stack above
# and gives a working torch on its own. LEDS_CLASS_FLASH is off in defconfig
# and is what the driver registers through; V4L2_FLASH_LED_CLASS is what lets
# the same driver also appear as a V4L2 flash subdev for the camera pipeline.
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_V4L2_FLASH_LED_CLASS=m
CONFIG_LEDS_SGM3140=m

# DMA-BUF heaps, which is what makes the camera usable from an application
# rather than merely present.
#
# CAMSS emits raw Bayer, so something has to debayer it, and on this SoC that
# something is libcamera's software ISP -- the `simple` pipeline handler lists
# qcom-camss with softISP enabled. softISP allocates its buffers through
# libcamera's DmaBufAllocator, which needs a dma-buf provider: /dev/dma_heap/*
# or /dev/udmabuf. arm64 defconfig gives neither.
#
# Without it libcamera still enumerates the camera and still streams raw, and
# the only sign of trouble is three lines that do not mention the camera:
#
#   ERROR DmaBufAllocator dma_buf_allocator.cpp:119 Could not open any dma-buf provider
#   ERROR SoftwareIsp software_isp.cpp:91 Failed to create DmaBufAllocator object
#   WARN  SimplePipeline simple.cpp:620 Failed to create software ISP, disabling software debayering
#
# -- after which every application that wants a normal pixel format sees a
# camera that offers only raw Bayer. There is no fallback path.
#
# UDMABUF is the second provider libcamera looks for and costs almost nothing;
# it is here so the lookup cannot fail for want of an alternative.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y

# The pmOS userspace conveniences that used to live here -- zram, nftables,
# the remainder of `pmbootstrap kconfig check`, ftrace/kprobes, DWARF5 -- are
# in fogona-extra.config. They are not needed to boot; see that file.
