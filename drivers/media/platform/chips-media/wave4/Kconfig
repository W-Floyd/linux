config VIDEO_WAVE4_VPU
	tristate "Chips&Media Wave410 HEVC decoder"
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV && OF
	depends on ARCH_TCC803X || COMPILE_TEST
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_MEM2MEM_DEV
	help
	  Stateful V4L2 decoder for the Chips&Media Wave410 HEVC decoder in
	  the Telechips TCC803x. It needs the firmware image that the vendor
	  ships inside its own kernel module.

	  To compile this driver as a module, choose M here: the module will
	  be called wave4.
