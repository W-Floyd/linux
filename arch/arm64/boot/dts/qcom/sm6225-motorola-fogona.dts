// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
/*
 * Motorola Moto G Play (2024) -- "fogona", XT2413, SM6225 (khaje).
 *
 * Copyright (c) 2026 William Floyd
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "sm6225.dtsi"
#include "pm6125.dtsi"

/ {
	model = "Motorola Moto G Play (2024)";
	compatible = "motorola,fogona", "qcom,sm6225", "qcom,sm6115";
	chassis-type = "handset";

	/*
	 * Measured, not inherited: /sys/devices/soc0/soc_id = 518, revision 1.0.
	 * fogona ships two base DTBs differing only in this property (0x24a and
	 * 0x206); this unit is 0x206 = 518. board-id is the pair carried by the
	 * dtbo overlay ABL actually selects at runtime.
	 */
	qcom,msm-id = <518 0x10000>;
	qcom,board-id = <0x41 0xa000>;

	chosen {
		/*
		 * The two remaining *_ignore_unused are inherited from the
		 * simple-framebuffer era: ABL handed over with the panel lit
		 * and its clocks/rails running, simplefb claimed none of them,
		 * and the late-boot "disable everything unclaimed" passes then
		 * turned the display off -- Tux drawn, then black.
		 *
		 * regulator_ignore_unused was dropped 2026-09-10 and is NOT
		 * coming back. That premise no longer holds for rails, because
		 * the panel driver claims its own: icnl9916_panel_prepare()
		 * calls regulator_bulk_enable() on vddio/avdd/avee and
		 * _unprepare() releases them. Measured on hardware without the
		 * flag -- lcd_panel_avdd and lcd_panel_avee sit at use=0 while
		 * blanked, regulator_init_complete disables them, and the next
		 * prepare() turns them straight back on. Observed 0 -> 1 within
		 * one boot, backlight back to 1637. The other rails the pass
		 * touches are the ath10k ones, which have no driver holding
		 * them because WiFi does not work yet, and dummy regulators.
		 *
		 * L9A (LCD_1.8V) is a separate matter and was never what the
		 * flag protected: the PM6225 datasheet says it must never be
		 * turned off (it also carries VDD_PX31..36 and LPDDR4x_VDD1),
		 * and it is already regulator-always-on in this DTS, which is
		 * what actually keeps it up.
		 *
		 * clk_ignore_unused and pd_ignore_unused are UNTESTED. Drop
		 * them one at a time, not together -- they guard different
		 * subsystems, and unlike the rails there is no equivalent
		 * measurement yet showing a driver claims what ABL left on.
		 *
		 * androidboot.slot_suffix is not for Android's benefit: it is
		 * how msm-firmware-loader finds the slotted partitions. Its
		 * ab_get_slot() reads this from /proc/cmdline, and booting
		 * through U-Boot means nothing else sets it -- so without it
		 * the loader looks for partitions literally named "modem" and
		 * "vendor", finds only the unslotted "persist", and silently
		 * provides no firmware at all. Hardcoded because slot A is
		 * active; installing qbootctl would track the real slot.
		 */
		bootargs = "console=tty0 loglevel=7 panic=0 fbcon=map:0,font:6x10 clk_ignore_unused pd_ignore_unused pmos.nosplash plymouth.enable=0 ignore_loglevel rdinit=/init.pmos androidboot.slot_suffix=_a";
	};

	/*
	 * simple-framebuffer at the DT ROOT, not under /chosen.
	 * of_platform_default_populate() walks the root; a /chosen child relies
	 * on one special-cased lookup, and on this port that lookup did not
	 * fire -- the driver never probed and 40 lines of pr_emerg produced
	 * nothing on the panel. Moved to the root, fbcon came up immediately
	 * and drew the Tux logo.
	 *
	 * ABL leaves its splash lit at the base of cont_splash_mem, confirmed
	 * from the live tree as splash_region@5c000000 / 0xf00000. The panel is
	 * 720x1600; the region must stay no-map or simplefb's devm_ioremap_wc()
	 * refuses it (arm64 ioremap rejects mapped memory).
	 */
	framebuffer0: framebuffer@5c000000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0x5c000000 0x0 (720 * 1600 * 4)>;
		width = <720>;
		height = <1600>;
		stride = <(720 * 4)>;
		format = "a8r8g8b8";
	};

	/*
	 * The gauge reports state of charge as a percentage and knows nothing
	 * about pack size, so the design capacity has to come from here.
	 * 5000 mAh matches stock's fcc_design of 0x1388 for all three packs.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <5000000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4400000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		/*
		 * Volume-up is on the PMIC, not TLMM. The schematic routes
		 * KYPD_VOLP_N to PM6225 GPIO_05 (pad 21), and the stock dtbo
		 * agrees: its vol_up node reads `gpios = <0xffffffff 0x05 0x01>`
		 * with the fixups block resolving that dangling phandle to
		 * `pm6125_gpios`. Reading the overlay without applying the
		 * fixups yields "gpio 5" with no controller, and TLMM 5 is the
		 * natural wrong guess -- which is exactly the guess this file
		 * used to make.
		 *
		 * All three side keys are on the PMIC: power -> KPD_PWR_N and
		 * volume-down -> RESIN_N (both via pon, enabled below), and
		 * volume-up here. There is no TLMM key on this board.
		 */
		key-volume-up {
			label = "Volume Up";
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
		};
	};
};

/*
 * khaje reserves GPIOs 14-17. Straight from Qualcomm's own driver:
 *
 *   static const int khaje_reserved_gpios[] = { 14, 15, 16, 17, -1 };
 *       -- drivers/pinctrl/qcom/pinctrl-khaje.c
 *
 * Touching them during gpio init is what crashes TLMM on this SoC.
 */
&tlmm {
	gpio-reserved-ranges = <14 4>;

	typec_int_n: typec-int-state {
		pins = "gpio84";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	te_active: te-active-state {
		pins = "gpio81";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdss_dsi_active: dsi-active-state {
		pins = "gpio82";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	panel_avdd_default: panel-avdd-state {
		pins = "gpio111";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	ts_int_default: ts-int-state {
		pins = "gpio80";
		function = "gpio";
		bias-pull-up;
	};

	ts_reset_default: ts-reset-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

/*
 * RPM regulators. khaje's rails are pm6125 LDOs behind RPM/SMD (the SoC has an
 * Arm Cortex-M3 RPM, not RPMh), so they are declared per-board here rather
 * than in pm6125.dtsi -- which describes only the SPMI side.
 *
 * Only the rails this port actually uses are declared. Voltage windows are the
 * sibling sm6225-lenovo-tb128.dts values, which match the PM6225 datasheet
 * ranges; L18 carries the note "fixed @ 1.232V for DSIPHY" there and is also
 * fogona's UFS vdda-pll.
 */
&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		pm6125_l4: l4 {
			regulator-min-microvolt = <720000>;
			regulator-max-microvolt = <1050000>;
		};

		/*
		 * The panel's vddio. Marked always-on deliberately: LCD_1.8V
		 * is VREG_L9A, which the PM6225 datasheet says must never be
		 * turned off -- it also carries VDD_PX31..36 and LPDDR4x_VDD1.
		 * Now that a driver holds a handle on it, always-on is what
		 * stops a panel unprepare from taking the board down with it.
		 */
		pm6125_l9: l9 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
			regulator-always-on;
		};

		pm6125_l11: l11 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1950000>;
		};

		pm6125_l12: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l15: l15 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};

		pm6125_l18: l18 {
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l24: l24 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};

		/*
		 * WCN3988 rails. The PM6225 datasheet gives L8 as VDD_WCSS_CX,
		 * L16 as WCN 1.8 V, L17 as WCN 1.3 V and L23 as WCN 3.3 V, and
		 * the windows below are the ones the bengal boards use for the
		 * same four rails feeding the same connectivity part.
		 */
		pm6125_l8: l8 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
		};

		pm6125_l16: l16 {
			regulator-min-microvolt = <1704000>;
			regulator-max-microvolt = <1904000>;
		};

		pm6125_l17: l17 {
			regulator-min-microvolt = <1152000>;
			regulator-max-microvolt = <1384000>;
		};

		pm6125_l23: l23 {
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3400000>;
		};
	};
};

/*
 * UFS rails, resolved from the phandles in fogona's own live device tree
 * (/sys/firmware/fdt on the running stock kernel) and cross-checked against
 * the PM6225 datasheet's rail table:
 *
 *   vcc      -> pm6125_l24   (EMMC1_VCC / UFS_MEM, 2.96 V)
 *   vccq2    -> pm6125_l11   (eMMC1_VCCQ, 1.8 V)
 *   vdda-phy -> pm6125_l4    (EBI_PLL / UFS)
 *   vdda-pll -> pm6125_l18
 *
 * vdd-hba is deliberately absent: stock declares it as
 * `vdd-hba-supply = <&gcc_ufs_phy_gdsc>` with `vdd-hba-fixed-regulator`, i.e.
 * the GDSC power domain rather than an LDO -- which sm6225.dtsi already
 * expresses as power-domains = <&gcc GCC_UFS_PHY_GDSC>. The sibling
 * sm6225-lenovo-tb128.dts points vdd-hba at pm6125_l18 with the comment
 * "??? sus"; per the datasheet L18 is MIPI_CSI_1P2, so that assignment looks
 * wrong and is not copied here.
 */
&ufs_mem_hc {
	vcc-supply = <&pm6125_l24>;
	vcc-max-microamp = <600000>;
	vccq2-supply = <&pm6125_l11>;
	vccq2-max-microamp = <600000>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&pm6125_l4>;
	vdda-pll-supply = <&pm6125_l18>;
	status = "okay";
};

/*
 * sm6225.dtsi declares both of these as fixed-clock with NO frequency, leaving
 * each board to supply it -- and everything derived from the XO is 0 Hz until
 * it does. That surfaced as ufs-qcom reporting "invalid ref_clk setting = 0",
 * because its ref_clk is <&rpmcc RPM_SMD_XO_CLK_SRC>.
 *
 * 19200000 is what the SoC's CXO input sees, NOT the 38.4 MHz crystal: the
 * SM6225 datasheet's section 3.11.1.1 is titled "19.2 MHz CXO input", and the
 * live downstream tree agrees (0x124f800). Do not "correct" this to 38.4 MHz.
 *
 * 32764 is the PMIC's generated sleep clock: the PM6225 datasheet describes
 * "using the 38.4 MHz XO circuit and dividing its output by 1172", and
 * 38400000/1172 = 32764.5. Both upstream bengal boards use exactly 32764.
 */
&xo_board {
	clock-frequency = <19200000>;
};

&sleep_clk {
	clock-frequency = <32764>;
};

/*
 * Fuel gauge: CellWise CW2217 on SE2 I2C, the bus Motorola calls SAR_I2C.
 *
 * Stock declares three gauges on this bus -- cw2217@64, sm5602@71 and
 * rt9426a@55 -- and picks one at runtime, because the part is second sourced.
 * This unit has the CW2217: its stock kernel loads cw2217b_fg_mmi and logs
 * from FG_CW2217, and the schematic's 5 mohm sense resistor (R1809) matches a
 * coulomb counter rather than the voltage-only alternatives.
 *
 * cw,user_rsense is in milliohms scaled by 1000, not plain milliohms -- the
 * driver's own default is 1500 for a 1.5 mohm shunt. This board's R1809 is
 * 5 mohm, so 5000. Getting the scale wrong does not fail visibly: the gauge
 * still reports a plausible-looking current, just off by a factor of 1000.
 *
 * The battery profile is the 80-byte table stock ships for the SUNWODA 5000 mAh
 * pack, transcribed from its config_profile_info. Stock carries three, keyed by
 * pack serial; this handset reports SB18D96854, which selects that one. A pack
 * from another vendor would need the SCUD table instead -- the gauge would still
 * work, but its capacity curve would be wrong rather than obviously broken.
 *
 * No thermistor is wired to the gauge: stock sets factory_mode_ntc_exist = 0
 * and the running driver agrees, so temperature comes from elsewhere.
 */
&i2c2 {
	status = "okay";

	fuel-gauge@64 {
		compatible = "cellwise,cw221X";
		reg = <0x64>;

		monitored-battery = <&battery>;

		cw,user_rsense = <5000>;

		cellwise,battery-profile = [
			5a 00 00 00 00 00 00 00 a8 ba
			ad bf a5 a0 de c9 bb ff e6 bc
			8b 75 61 55 4f 4e 4d c1 a3 e2
			dd ff fa cb d2 d8 d9 d8 d4 cf
			ca c7 ce ca a4 93 8b 81 73 6e
			7e 97 ac 8f 7e 64 20 00 ab 10
			02 a0 5f 00 00 00 64 23 c3 55
			00 00 00 00 00 00 00 00 00 c6
		];
	};
};

/*
 * WiFi: WCN3988, driven by ath10k over SNOC.
 *
 * The WLAN core does not run its own downloaded firmware the way the touch
 * controller does -- wifi@c800000 carries qcom,msa-fixed-perm, meaning the
 * modem has already been given access to the shared memory area. So the modem
 * has to be running first, which is why remoteproc_mpss is enabled below; the
 * bengal boards do exactly the same pairing.
 *
 * Everything needed is on the device rather than redistributable: modem.mdt
 * and wlanmdsp.mbn live in the modem partition, alongside this handset's own
 * board data as bdwlan_fogona_ipa.bin / _epa.bin. msm-firmware-loader mounts
 * that partition and links its image/ directory into the firmware search path.
 */
&wifi {
	vdd-0.8-cx-mx-supply = <&pm6125_l8>;
	vdd-1.8-xo-supply = <&pm6125_l16>;
	vdd-1.3-rfa-supply = <&pm6125_l17>;
	vdd-3.3-ch0-supply = <&pm6125_l23>;
	status = "okay";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm6225/motorola/fogona/modem.mdt";
	status = "okay";
};

/*
 * Touchscreen: ChipOne ICNL9916C, a TDDI part that drives the panel and the
 * digitizer from one package. The touch half is on SPI SE0, which is how stock
 * has it -- its overlay's fixups resolve fragment@60's target to
 * `qupv3_se0_spi`, and the node carries spi-max-frequency = 9.6 MHz with the
 * interrupt on TLMM 80 and reset on TLMM 86.
 *
 * reg = <0>, NOT <1>, even though stock names the node chipone_tddi@1. Stock
 * declares three touch nodes on this one bus -- novatek@0, chipone_tddi@1 and
 * ilitek@2 -- for the three panel variants fogona shipped, selected at runtime
 * by matching mmi,panel_name. They cannot be three chip selects: qup_spi0's
 * pinctrl muxes a single CS (gpio3). Motorola's own driver settles it by
 * overriding whatever DT said:
 *
 *     pdata->spi_client->chip_select = 0;
 *         -- cts_platform.c, cts_plat_spi_setup()
 *
 * So the @N suffixes are variant slots, and the real chip select is 0.
 *
 * 6 MHz rather than the 9.6 MHz stock allows: that is what the vendor driver
 * actually clocks (CFG_CTS_SPI_SPEED_KHZ 6000), so it is the rate the part is
 * known to work at. Raise it once the controller is talking.
 *
 * Falling-edge interrupt matches the vendor's IRQF_TRIGGER_FALLING. The reset
 * line is active low: the driver pulses the logical line high then low, which
 * for a RESET_N pin has to invert.
 */
/*
 * The QUP wrapper gates every serial engine under it, so enabling spi0 alone
 * does nothing: geniqup@4ac0000 ships disabled, and a disabled parent means
 * of_platform never populates its children. Symptom is not a probe failure but
 * total absence -- no 4a80000.spi platform device, nothing in
 * /sys/bus/spi/devices, and not one geni line in dmesg.
 *
 * Note i2c0 and spi0 share address 0x4a80000: SE0 is one engine that is either
 * an I2C or a SPI port, never both. i2c0 must stay disabled.
 */
&qupv3_id_0 {
	status = "okay";
};

/*
 * gpi_dma0 is deliberately left disabled. spi0 lists it in `dmas`, but
 * spi-geni-qcom falls back to PIO when the channels cannot be obtained, and
 * PIO is more than enough for a touch controller whose largest transfer is a
 * 77-byte report.
 */
&spi0 {
	status = "okay";

	touchscreen@0 {
		compatible = "chipone,icnl9916";

		/*
		 * TDDI: this is the same chip as the panel, so its power
		 * sequencing is the panel's. Following the panel is what tells
		 * the touch half to reload its SRAM firmware after a blank
		 * has reset the shared silicon.
		 */
		panel = <&panel>;
		reg = <0>;
		/* 1 MHz while bringing the link up; stock allows 9.6 MHz. */
		spi-max-frequency = <1000000>;

		interrupts-extended = <&tlmm 80 IRQ_TYPE_EDGE_FALLING>;
		touchscreen-reset-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_int_default>, <&ts_reset_default>;
	};
};

/*
 * USB, high-speed only. fogona routes no superspeed at all (Motorola's
 * schematics break USB_CC1/CC2 out to testpoints but carry no SBU, and
 * USB0_SS_* / USB0_DP_AUX_* have no cross-sheet routing), so dwc3 is pinned to
 * the HS phy and `qcom,select-utmi-as-pipe-clk` stands in for the absent SS
 * phy's pipe clock.
 *
 * Unlike U-Boot -- which has no SMD/RPM regulator driver and therefore cannot
 * bring these rails up at all -- Linux can, which is why USB is worth enabling
 * here: it gives a console channel that does not depend on the panel.
 *
 * Rails per the PM6225 datasheet, cross-checked against the board's analog
 * rail traces (FOGONA-BOARD.md 1): vdda-pll -> L4 (VDD_A_USBHS_0P9),
 * vdda18 -> L12 (VDD_TXDAC/USB 1.8 V), vdda33 -> L15 (VDD_A_USBHS_3P1,
 * proven -- only L15A instance on the sheet).
 *
 * These property names are correct for THIS node and must not be "corrected"
 * to j606f's. sm6225.dtsi declares usb_hsphy as "qcom,usb-snps-hs-7nm-phy"
 * (phy-qcom-snps-femto-v2.c, which asks for vdda-pll/vdda33/vdda18), whereas
 * mainline sm6115.dtsi declares it as "qcom,sm6115-qusb2-phy"
 * (phy-qcom-qusb2.c, which asks for vdd/vdda-pll/vdda-phy-dpdm). Different
 * driver, different names, same three board rails.
 */
/*
 * Type-C CC logic: SGM7220 at 0x47 on QUP SE1, interrupt on GPIO 84. Wiring is
 * Motorola's, from kernel-devicetree/qcom/sgm7220.dtsi via
 * khaje-fogona-common-overlay.dtsi.
 *
 * "ti,tusb320" is not an approximation. The SGM7220 is a register-level
 * TUSB320 clone: same default address, and it returns the literal signature
 * "TUSB320" from registers 7..0, which is what tusb320_check_signature()
 * compares against. Confirmed independently by Quectel's own SGM7220 driver,
 * which checks the identical byte array -- and now on hardware, where the port
 * reports a live power_operation_mode read back over i2c.
 *
 * This exists to give dwc3 connect/disconnect events. Without a role-switch
 * provider dwc3 pulls up once at boot and can never recover a lost session --
 * observed as usb0 going DOWN with the UDC reading "not attached", and
 * unrecoverable by replugging because the VBUS event had no consumer.
 *
 * UFP-only on purpose: this handset is never a host, and vendor configures
 * Try.SNK. The role switch is here to report DEVICE and NONE.
 */
&i2c1 {
	status = "okay";

	typec@47 {
		compatible = "ti,tusb320";
		reg = <0x47>;

		interrupts-extended = <&tlmm 84 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&typec_int_n>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "sink";
			data-role = "device";
			typec-power-opmode = "default";

			port {
				typec_hs: endpoint {
					remote-endpoint = <&usb_dwc3_hs>;
				};
			};
		};
	};
};

&usb_dwc3_hs {
	remote-endpoint = <&typec_hs>;
};

&usb {
	qcom,select-utmi-as-pipe-clk;
	status = "okay";
};

&usb_dwc3 {
	/*
	 * usb-role-switch is KEPT, reversing what this comment used to say.
	 *
	 * It was deleted here for good reason: sm6225.dtsi sets it, dwc3 then
	 * waits for a provider to say host-or-peripheral, and fogona had none --
	 * so the role never arrived and /sys/class/udc stayed empty even with a
	 * working phy. j606f does the same, for the same reason.
	 *
	 * The SGM7220 above is that provider now. Keeping the deletion also meant
	 * dwc3 had no connect/disconnect events at all, so a session lost to a
	 * host suspend or bus reset could never be recovered -- usb0 went DOWN
	 * with the UDC "not attached" and nothing, replugging included, brought
	 * it back. On a board whose only debug channel is this port, that is
	 * worse than the problem the deletion solved.
	 *
	 * high-speed and the usb2-phy-only phys list are NOT just inherited from
	 * j606f: this board physically cannot do SuperSpeed. USB0_SS_* and
	 * USB0_DP_AUX_* appear in the SoC pinout with no routing, the test-point
	 * bank breaks out only CC1/CC2 and the HS pair, and the eLDO in the
	 * power-on sequence gates SuperSpeed DP that is not there
	 * (FOGONA-BOARD.md 3 and 4). The SoC offers USB 3.1 and khaje-usb.dtsi
	 * asks for "super-speed", but khaje is the SoC, not this handset.
	 *
	 * So do not "restore" SuperSpeed here. usb_qmpphy is already disabled in
	 * sm6225.dtsi and must stay that way; ABL still leaves its clocks
	 * running, which is why gcc_usb3_prim_phy_* show up hardware-enabled
	 * with no consumer in clk_summary. Those are safe to gate -- they feed a
	 * PHY whose outputs go nowhere.
	 */
	maximum-speed = "high-speed";
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
	/*
	 * "otg", not "peripheral", and this is load-bearing rather than scope
	 * creep. dwc3 calls dwc3_drd_init() -- and therefore
	 * dwc3_setup_role_switch() -> usb_role_switch_register() -- ONLY under
	 * case USB_DR_MODE_OTG. With "peripheral" no role switch is registered,
	 * so the tusb320's fwnode_usb_role_switch_get() returns -EPROBE_DEFER
	 * forever and the chip never binds. Measured exactly that: 0-0047 sat on
	 * /sys/kernel/debug/devices_deferred, driver registered and device
	 * present but unbound, while USB still worked because "peripheral"
	 * forces device mode on its own.
	 *
	 * This does not make the handset a host. dwc3_setup_role_switch()
	 * defaults role_switch_default_mode to PERIPHERAL and sets
	 * DWC3_GCTL_PRTCAP_DEVICE at probe unless role-switch-default-mode says
	 * "host", so the gadget comes up at boot before any CC event.
	 */
	dr_mode = "otg";
	role-switch-default-mode = "peripheral";
};

&usb_hsphy {
	vdda-pll-supply = <&pm6125_l4>;
	vdda18-supply = <&pm6125_l12>;
	vdda33-supply = <&pm6125_l15>;
	status = "okay";
};

/*
 * The whole Adreno block is off for this bringup, and that is a deliberate
 * noise-reduction measure as much as a scope one.
 *
 * gpu / gmu_wrapper / adreno_smmu are the only consumers of &gpucc, and
 * adreno_smmu@59a0000 is the ONLY iommu in sm6225.dtsi with a clocks property.
 * Left enabled without gpucc it fails as
 *   arm-smmu 59a0000.iommu: probe failed -110
 * and emits "supplier <addr>.clock-controller not ready", which reads exactly
 * like a storage problem and is not one: ufs_mem_hc's iommu is
 * apps_smmu@c600000, which has no clocks at all. Disabling these three removes
 * that entire false trail.
 *
 * The GPU is also not reachable yet for an unrelated reason: A610 needs
 * a610_zap.mdt and a630_sqe.fw, and mainline's A610 speedbin table is
 * bengal-only with no khaje entry (see SM6225.md).
 */
/*
 * Display. The bootloader lights the panel and simple-framebuffer above shows
 * it, but that is a static buffer -- no modesetting, no backlight, no power
 * management. This wires up the real pipeline: MDSS/DPU -> DSI0 -> the panel.
 *
 * simple-framebuffer is deliberately left in place. msm_kms calls
 * aperture_remove_all_conflicting_devices() when KMS comes up, so simpledrm is
 * evicted automatically once this works, and survives as a usable console if
 * it does not.
 *
 * Panel power. The Tianma module wants three rails, named as its own bindings
 * name them rather than as the vendor's dsi_panel_pwr_supply does:
 *
 *   vddio -> VREG_L9A       (1.8 V logic, always-on -- see above)
 *   avdd  -> lcd_panel_avdd (vendor "lab",  +5.9 V, gated by TLMM 111)
 *   avee  -> lcd_panel_avee (vendor "ibb",  -5.9 V, gated by PM6125 GPIO2)
 *
 * The two 5.9 V rails are not PMIC LDOs: they come from a bias chip enabled by
 * a GPIO, so they are fixed regulators here. Both are boot-on because the
 * bootloader has already brought the panel up.
 */
/ {
	lcd_panel_avdd: regulator-lcd-avdd {
		compatible = "regulator-fixed";
		regulator-name = "lcd_panel_avdd";
		regulator-min-microvolt = <5900000>;
		regulator-max-microvolt = <5900000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 111 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;

		pinctrl-names = "default";
		pinctrl-0 = <&panel_avdd_default>;
	};

	lcd_panel_avee: regulator-lcd-avee {
		compatible = "regulator-fixed";
		regulator-name = "lcd_panel_avee";
		regulator-min-microvolt = <5900000>;
		regulator-max-microvolt = <5900000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&pm6125_gpios 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	/* L18 is fixed at 1.232 V for the DSI PHY; it is also UFS's vdda-pll. */
	vdda-supply = <&pm6125_l18>;
	status = "okay";

	panel: panel@0 {
		compatible = "tianma,icnl9916c-720x1600";
		reg = <0>;

		reset-gpios = <&tlmm 82 GPIO_ACTIVE_LOW>;

		vddio-supply = <&pm6125_l9>;
		avdd-supply = <&lcd_panel_avdd>;
		avee-supply = <&lcd_panel_avee>;

		pinctrl-names = "default";
		pinctrl-0 = <&te_active &mdss_dsi_active>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	status = "okay";
};

&gpu {
	status = "disabled";
};

&gmu_wrapper {
	status = "disabled";
};

&adreno_smmu {
	status = "okay";
};
