// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
/*
 * Motorola Moto G Play (2024) -- "fogona", XT2413, SM6225 (khaje).
 *
 * Everything common to the board. fogona is dual-sourced for the display, and
 * the panel is a TDDI part that drives touch as well, so BOTH the panel and the
 * touch controller are per-variant and live in the including .dts:
 *
 *   sm6225-motorola-fogona-icnl9916c.dts   Tianma ICNL9916C   (this unit)
 *   sm6225-motorola-fogona-nt36528.dts     CSOT NT36528       (not written)
 *   sm6225-motorola-fogona-ili9883c.dts    TXD ILI9883C       (not written)
 *
 * Stock does the same thing at runtime instead, declaring all three touch nodes
 * on one SPI bus and matching mmi,panel_name; separate DTBs is the mainline way.
 *
 * Copyright (c) 2026 William Floyd
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include "sm6225.dtsi"
#include "pm6125.dtsi"

/ {
	model = "Motorola Moto G Play (2024)";
	compatible = "motorola,fogona", "qcom,sm6225", "qcom,sm6115";
	chassis-type = "handset";

	/*
	 * Measured, not inherited: /sys/devices/soc0/soc_id = 518, revision 1.0.
	 * fogona ships two base DTBs differing only in this property (0x24a and
	 * 0x206); this unit is 0x206 = 518. board-id is the pair carried by the
	 * dtbo overlay ABL actually selects at runtime.
	 */
	qcom,msm-id = <518 0x10000>;
	qcom,board-id = <0x41 0xa000>;

	/*
	 * uart3 is the only GENI UART enabled as a plain (non-console) serdev
	 * bus on this board -- the Bluetooth link. With no /aliases node at
	 * all, qcom_geni_serial_probe()'s of_alias_get_highest_id("serial")
	 * returns -ENODEV and the ida_alloc_range() that follows it fails,
	 * so the port never registers ("Invalid line -19"). qrb4210-rb2.dts
	 * hits the same requirement and assigns serial1 to its uart3.
	 */
	aliases {
		serial1 = &uart3;
	};

	chosen {
		/*
		 * The two remaining *_ignore_unused are inherited from the
		 * simple-framebuffer era: ABL handed over with the panel lit
		 * and its clocks/rails running, simplefb claimed none of them,
		 * and the late-boot "disable everything unclaimed" passes then
		 * turned the display off -- Tux drawn, then black.
		 *
		 * regulator_ignore_unused was dropped 2026-09-10 and is NOT
		 * coming back. That premise no longer holds for rails, because
		 * the panel driver claims its own: icnl9916_panel_prepare()
		 * calls regulator_bulk_enable() on vddio/avdd/avee and
		 * _unprepare() releases them. Measured on hardware without the
		 * flag -- lcd_panel_avdd and lcd_panel_avee sit at use=0 while
		 * blanked, regulator_init_complete disables them, and the next
		 * prepare() turns them straight back on. Observed 0 -> 1 within
		 * one boot, backlight back to 1637. The other rails the pass
		 * touches are the ath10k ones, which have no driver holding
		 * them because WiFi does not work yet, and dummy regulators.
		 *
		 * L9A (LCD_1.8V) is a separate matter and was never what the
		 * flag protected: the PM6225 datasheet says it must never be
		 * turned off (it also carries VDD_PX31..36 and LPDDR4x_VDD1),
		 * and it is already regulator-always-on in this DTS, which is
		 * what actually keeps it up.
		 *
		 * pd_ignore_unused was dropped 2026-09-11, also tested. Only
		 * three domains were at risk -- hlos1_vote_mm_snoc_mmu_tbu_rt,
		 * _nrt and hlos1_vote_turing_mmu_tbu0 -- all on with no DT node
		 * referencing them, so unlike the display clocks they could not
		 * gain a consumer by waking the screen. All four TBU GDSCs are
		 * VOTABLE, meaning the HLOS vote is one of several and dropping
		 * it does not force the block off; hlos1_vote_turing_mmu_tbu1
		 * was already off before the change with nothing broken, which
		 * is the precedent. Measured without the flag: genpd reports
		 * "Disabling unused power domains", all four TBUs read off-0,
		 * mdss_gdsc/gcc_usb30_prim/gcc_ufs_phy stay on because they
		 * have real consumers, and display, GPU, Type-C, UFS and SSH
		 * are all unaffected with zero SMMU faults.
		 *
		 * clk_ignore_unused is UNTESTED and should stay for now. It is
		 * a much worse bet than the other two were: 55 clocks are
		 * hardware-enabled with no consumer, spanning USB3 PHY, SDCC,
		 * QUP, CPU and -- the real problem -- snoc/ipa/ce1 interconnect
		 * and RPM votes that no mainline driver on this port claims.
		 * Gating interconnect hangs the bus with no diagnostic, which
		 * is the same failure class as the adreno SMMU bug. It becomes
		 * droppable when those subsystems have drivers, not before.
		 *
		 * androidboot.slot_suffix is not for Android's benefit: it is
		 * how msm-firmware-loader finds the slotted partitions. Its
		 * ab_get_slot() reads this from /proc/cmdline, and booting
		 * through U-Boot means nothing else sets it -- so without it
		 * the loader looks for partitions literally named "modem" and
		 * "vendor", finds only the unslotted "persist", and silently
		 * provides no firmware at all. Hardcoded because slot A is
		 * active; installing qbootctl would track the real slot.
		 */
		bootargs = "console=tty0 loglevel=7 panic=0 fbcon=map:0,font:6x10 clk_ignore_unused pmos.nosplash plymouth.enable=0 ignore_loglevel rdinit=/init.pmos androidboot.slot_suffix=_a";
	};

	/*
	 * simple-framebuffer at the DT ROOT, not under /chosen.
	 * of_platform_default_populate() walks the root; a /chosen child relies
	 * on one special-cased lookup, and on this port that lookup did not
	 * fire -- the driver never probed and 40 lines of pr_emerg produced
	 * nothing on the panel. Moved to the root, fbcon came up immediately
	 * and drew the Tux logo.
	 *
	 * ABL leaves its splash lit at the base of cont_splash_mem, confirmed
	 * from the live tree as splash_region@5c000000 / 0xf00000. The panel is
	 * 720x1600; the region must stay no-map or simplefb's devm_ioremap_wc()
	 * refuses it (arm64 ioremap rejects mapped memory).
	 */
	framebuffer0: framebuffer@5c000000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0x5c000000 0x0 (720 * 1600 * 4)>;
		width = <720>;
		height = <1600>;
		stride = <(720 * 4)>;
		format = "a8r8g8b8";
	};

	/*
	 * Persistent kernel log across reboots. CONFIG_PSTORE_RAM is already
	 * enabled, but without a region the driver is inert -- which is why an
	 * unexplained reboot leaves nothing behind. That matters more than
	 * usual here: every boot is a manual `fastboot boot`, so a crash that
	 * explains itself is worth a lot.
	 *
	 * Address and sizes are Motorola's own for this SoC, from
	 * kernel-msm/include/dt-bindings/moto/moto-mem-reserve.h
	 * (RAMOOPS_BASE_ADDR 0xaf000000, console 0x40000, record 0x3f800,
	 * total 0xbf800), used by khaje-moto-common-overlay.dtsi. So the
	 * bootloader already treats it as scratch and nothing else claims it;
	 * our own highest reserved region is rmtfs at 0x89b01000, far below.
	 *
	 * No `no-map`: ramoops needs the region mapped to read it back, and
	 * every in-tree arm64 qcom example omits it. pmsg-size is omitted too
	 * because CONFIG_PSTORE_PMSG is off -- the space then goes to extra
	 * dump records instead.
	 *
	 * After a crash the previous boot's log is at /sys/fs/pstore/.
	 */
	reserved-memory {
		ramoops@af000000 {
			compatible = "ramoops";
			reg = <0x0 0xaf000000 0x0 0xbf800>;
			console-size = <0x40000>;
			record-size = <0x3f800>;
		};
	};

	/*
	 * The gauge reports state of charge as a percentage and knows nothing
	 * about pack size, so the design capacity has to come from here.
	 * 5000 mAh matches stock's fcc_design of 0x1388 for all three packs.
	 *
	 * operating-range-celsius is the charge window, and nothing in mainline
	 * reads it on this board yet -- bq25890_charger does not call
	 * power_supply_get_battery_info(). It is recorded because it is the only
	 * upstream way to state the pack's temperature limits at all: there is
	 * no binding for JEITA zones, so stock's mmi,mmi-temp-zones table, which
	 * derates to 4250 mV below 15C and 4200 mV above 45C, has no mainline
	 * expression. See the charger node for why that pushed the regulation
	 * voltage down to 4400 mV.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <5000000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4400000>;
		operating-range-celsius = <0 45>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		/*
		 * Volume-up is on the PMIC, not TLMM. The schematic routes
		 * KYPD_VOLP_N to PM6225 GPIO_05 (pad 21), and the stock dtbo
		 * agrees: its vol_up node reads `gpios = <0xffffffff 0x05 0x01>`
		 * with the fixups block resolving that dangling phandle to
		 * `pm6125_gpios`. Reading the overlay without applying the
		 * fixups yields "gpio 5" with no controller, and TLMM 5 is the
		 * natural wrong guess -- which is exactly the guess this file
		 * used to make.
		 *
		 * All three side keys are on the PMIC: power -> KPD_PWR_N and
		 * volume-down -> RESIN_N (both via pon, enabled below), and
		 * volume-up here. There is no TLMM key on this board.
		 */
		key-volume-up {
			label = "Volume Up";
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
		};
	};

	/*
	 * Speaker playback. Both amplifiers sit on the one primary MI2S port,
	 * so they are two codecs on a single dai-link rather than two links.
	 *
	 * The card deliberately programs no LPASS clocks of its own: under
	 * AudioReach the interface clocking belongs to the DSP graph, and
	 * q6apm-lpass-dais only takes an explicit bit clock when the port node
	 * carries "mclk"/"bclk" clock references, which it does not here. This
	 * mirrors monaco-evk, the other GPR board with a plain I2S codec on
	 * MI2S. If playback ever runs with no audible output and no error, the
	 * machine driver's mi2s_bclk_enable path is the first thing to try.
	 */
	sound {
		compatible = "motorola,fogona-sndcard";
		model = "Moto-G-Play-2024";

		pinctrl-0 = <&lpi_i2s1_active>;
		pinctrl-names = "default";

		pri-mi2s-dai-link {
			link-name = "Primary MI2S Playback";

			codec {
				sound-dai = <&speaker_amp>, <&receiver_amp>;
			};

			cpu {
				sound-dai = <&q6apmbedai PRIMARY_MI2S_RX>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};
	};
};

/*
 * khaje reserves GPIOs 14-17. Straight from Qualcomm's own driver:
 *
 *   static const int khaje_reserved_gpios[] = { 14, 15, 16, 17, -1 };
 *       -- drivers/pinctrl/qcom/pinctrl-khaje.c
 *
 * Touching them during gpio init is what crashes TLMM on this SoC.
 */
&tlmm {
	gpio-reserved-ranges = <14 4>;

	charger_int_n: charger-int-state {
		pins = "gpio28";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	typec_int_n: typec-int-state {
		pins = "gpio84";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	te_active: te-active-state {
		pins = "gpio81";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdss_dsi_active: dsi-active-state {
		pins = "gpio82";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	panel_avdd_default: panel-avdd-state {
		pins = "gpio111";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	ts_int_default: ts-int-state {
		pins = "gpio80";
		function = "gpio";
		bias-pull-up;
	};

	ts_reset_default: ts-reset-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	/*
	 * The rear sensor's master clock. This one IS a pinctrl group, unlike
	 * every camera *enable* below: GPIO_20 is muxed to cam_mclk and driven
	 * by GCC, so nothing requests it as a GPIO and the "already requested"
	 * conflict described at lcd_panel_avdd cannot arise here.
	 */
	cam_mclk0_default: cam-mclk0-state {
		pins = "gpio20";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	/*
	 * uart3 (SE3) is the Bluetooth UART, not a spare engine -- see
	 * investigations/bluetooth.md §1. gpio8-11 is CTS/RTS/TX/RX with flow
	 * control; groups copied from qrb4210-rb2.dts, the bengal-class board
	 * on the same SE3/qup3 pins.
	 */
	uart3_default: uart3-default-state {
		cts-pins {
			pins = "gpio8";
			function = "qup3";
			drive-strength = <2>;
			bias-bus-hold;
		};

		rts-pins {
			pins = "gpio9";
			function = "qup3";
			drive-strength = <2>;
			bias-disable;
		};

		tx-pins {
			pins = "gpio10";
			function = "qup3";
			drive-strength = <2>;
			bias-disable;
		};

		rx-pins {
			pins = "gpio11";
			function = "qup3";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	uart3_sleep: uart3-sleep-state {
		cts-pins {
			pins = "gpio8";
			function = "gpio";
			drive-strength = <2>;
			bias-bus-hold;
		};

		rts-pins {
			pins = "gpio9";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
		};

		tx-pins {
			pins = "gpio10";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};

		rx-pins {
			pins = "gpio11";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

/*
 * RPM regulators. khaje's rails are pm6125 LDOs behind RPM/SMD (the SoC has an
 * Arm Cortex-M3 RPM, not RPMh), so they are declared per-board here rather
 * than in pm6125.dtsi -- which describes only the SPMI side.
 *
 * Only the rails this port actually uses are declared. Voltage windows are the
 * sibling sm6225-lenovo-tb128.dts values, which match the PM6225 datasheet
 * ranges; L18 carries the note "fixed @ 1.232V for DSIPHY" there and is also
 * fogona's UFS vdda-pll.
 */
&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		/*
		 * The 0.9 V analog rail: UFS's vdda-phy, the DSI PHY's
		 * vdda-0p9 and VDD_A_CSI_0/1/2_0P9. The minimum here is the
		 * operating point, not the LDO's floor, because nothing on
		 * this board asks the regulator for a voltage -- so whatever
		 * the minimum says is what the rail sits at. With the LDO's
		 * 720 mV floor it sat at 720 mV, 20% under every consumer's
		 * nominal, which is measurable in /sys/class/regulator.
		 */
		pm6125_l4: l4 {
			regulator-min-microvolt = <900000>;
			regulator-max-microvolt = <1050000>;
		};

		/*
		 * The panel's vddio. Marked always-on deliberately: LCD_1.8V
		 * is VREG_L9A, which the PM6225 datasheet says must never be
		 * turned off -- it also carries VDD_PX31..36 and LPDDR4x_VDD1.
		 * Now that a driver holds a handle on it, always-on is what
		 * stops a panel unprepare from taking the board down with it.
		 */
		pm6125_l9: l9 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
			regulator-always-on;
		};

		pm6125_l11: l11 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1950000>;
		};

		pm6125_l12: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l15: l15 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};

		/*
		 * The 1.2 V PLL rail: UFS's vdda-pll, the DSI's vdda-1p2 and
		 * VDD_A_CSI_0/1/2_1P2. Same reasoning as L4 above -- it was
		 * sitting at its 1.1 V floor rather than the 1.2 V every
		 * consumer wants. The sibling tb128 pins this at 1.232 V for
		 * the DSI PHY, which this window still allows.
		 */
		pm6125_l18: l18 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l24: l24 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};

		/*
		 * WCN3988 rails. The PM6225 datasheet gives L8 as VDD_WCSS_CX,
		 * L16 as WCN 1.8 V, L17 as WCN 1.3 V and L23 as WCN 3.3 V, and
		 * the windows below are the ones the bengal boards use for the
		 * same four rails feeding the same connectivity part.
		 */
		pm6125_l8: l8 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
		};

		pm6125_l16: l16 {
			regulator-min-microvolt = <1704000>;
			regulator-max-microvolt = <1904000>;
		};

		pm6125_l17: l17 {
			regulator-min-microvolt = <1152000>;
			regulator-max-microvolt = <1384000>;
		};

		pm6125_l23: l23 {
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3400000>;
		};
	};
};

/*
 * UFS rails, resolved from the phandles in fogona's own live device tree
 * (/sys/firmware/fdt on the running stock kernel) and cross-checked against
 * the PM6225 datasheet's rail table:
 *
 *   vcc      -> pm6125_l24   (EMMC1_VCC / UFS_MEM, 2.96 V)
 *   vccq2    -> pm6125_l11   (eMMC1_VCCQ, 1.8 V)
 *   vdda-phy -> pm6125_l4    (EBI_PLL / UFS)
 *   vdda-pll -> pm6125_l18
 *
 * vdd-hba is deliberately absent: stock declares it as
 * `vdd-hba-supply = <&gcc_ufs_phy_gdsc>` with `vdd-hba-fixed-regulator`, i.e.
 * the GDSC power domain rather than an LDO -- which sm6225.dtsi already
 * expresses as power-domains = <&gcc GCC_UFS_PHY_GDSC>. The sibling
 * sm6225-lenovo-tb128.dts points vdd-hba at pm6125_l18 with the comment
 * "??? sus"; per the datasheet L18 is MIPI_CSI_1P2, so that assignment looks
 * wrong and is not copied here.
 */
&ufs_mem_hc {
	vcc-supply = <&pm6125_l24>;
	vcc-max-microamp = <600000>;
	vccq2-supply = <&pm6125_l11>;
	vccq2-max-microamp = <600000>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&pm6125_l4>;
	vdda-pll-supply = <&pm6125_l18>;
	status = "okay";
};

/*
 * sm6225.dtsi declares both of these as fixed-clock with NO frequency, leaving
 * each board to supply it -- and everything derived from the XO is 0 Hz until
 * it does. That surfaced as ufs-qcom reporting "invalid ref_clk setting = 0",
 * because its ref_clk is <&rpmcc RPM_SMD_XO_CLK_SRC>.
 *
 * 19200000 is what the SoC's CXO input sees, NOT the 38.4 MHz crystal: the
 * SM6225 datasheet's section 3.11.1.1 is titled "19.2 MHz CXO input", and the
 * live downstream tree agrees (0x124f800). Do not "correct" this to 38.4 MHz.
 *
 * 32764 is the PMIC's generated sleep clock: the PM6225 datasheet describes
 * "using the 38.4 MHz XO circuit and dividing its output by 1172", and
 * 38400000/1172 = 32764.5. Both upstream bengal boards use exactly 32764.
 */
&xo_board {
	clock-frequency = <19200000>;
};

&sleep_clk {
	clock-frequency = <32764>;
};

/*
 * Fuel gauge: CellWise CW2217 on SE2 I2C, the bus Motorola calls SAR_I2C.
 *
 * Stock declares three gauges on this bus -- cw2217@64, sm5602@71 and
 * rt9426a@55 -- and picks one at runtime, because the part is second sourced.
 * This unit has the CW2217: its stock kernel loads cw2217b_fg_mmi and logs
 * from FG_CW2217, and the schematic's 5 mohm sense resistor (R1809) matches a
 * coulomb counter rather than the voltage-only alternatives.
 *
 * cw,user_rsense is in milliohms scaled by 1000, not plain milliohms -- the
 * driver's own default is 1500 for a 1.5 mohm shunt. This board's R1809 is
 * 5 mohm, so 5000. Getting the scale wrong does not fail visibly: the gauge
 * still reports a plausible-looking current, just off by a factor of 1000.
 *
 * The battery profile is the 80-byte table stock ships for the SUNWODA 5000 mAh
 * pack, transcribed from its config_profile_info. Stock carries three, keyed by
 * pack serial; this handset reports SB18D96854, which selects that one. A pack
 * from another vendor would need the SCUD table instead -- the gauge would still
 * work, but its capacity curve would be wrong rather than obviously broken.
 *
 * No thermistor is wired to the gauge: stock sets factory_mode_ntc_exist = 0
 * and the running driver agrees, so temperature comes from elsewhere.
 */
&i2c2 {
	status = "okay";

	fuel_gauge: fuel-gauge@64 {
		compatible = "cellwise,cw221X";
		reg = <0x64>;

		monitored-battery = <&battery>;

		cw,user_rsense = <5000>;

		cellwise,battery-profile = [
			5a 00 00 00 00 00 00 00 a8 ba
			ad bf a5 a0 de c9 bb ff e6 bc
			8b 75 61 55 4f 4e 4d c1 a3 e2
			dd ff fa cb d2 d8 d9 d8 d4 cf
			ca c7 ce ca a4 93 8b 81 73 6e
			7e 97 ac 8f 7e 64 20 00 ab 10
			02 a0 5f 00 00 00 64 23 c3 55
			00 00 00 00 00 00 00 00 00 c6
		];
	};

	/*
	 * The two speaker amplifiers. Both are AW88261s on the primary MI2S
	 * port, distinguished only by I2C address and channel: 0x34 is the
	 * loudspeaker, 0x35 the earpiece.
	 *
	 * awinic,audio-channel is not cosmetic and not a slot number -- it
	 * selects which tuning the shared ACF container applies, because
	 * aw88395_lib.c matches it against each section's dev_index. The
	 * container on this handset carries dev_index 0 and 1, so these values
	 * follow Motorola's own assignment rather than being chosen.
	 *
	 * firmware-name points at the vendor ACF, which msm-firmware-loader
	 * already exposes from the vendor partition -- the driver hard-fails
	 * probe without one, as there is no register-defaults fallback.
	 *
	 * No reset-gpios: the binding forbids them on aw88261, which has no
	 * reset pin. No interrupts either -- downstream wires TLMM 102 and 107
	 * to these parts, but mainline's driver has no interrupt support and
	 * the binding does not allow the property.
	 *
	 * sound-name-prefix is load-bearing, not decoration. Two instances of
	 * one codec driver on a single card register identically named controls
	 * and widgets, and the second one loses: "control PCM Playback Volume
	 * is already present", -EBUSY out of snd_soc_component_probe(), and the
	 * whole card fails to instantiate. The prefixes make them
	 * "Speaker ..." and "Receiver ...", which is also how userspace tells
	 * the two apart.
	 */
	speaker_amp: audio-codec@34 {
		compatible = "awinic,aw88261";
		reg = <0x34>;

		#sound-dai-cells = <0>;
		awinic,audio-channel = <1>;
		dvdd-supply = <&pm6125_l9>;
		firmware-name = "aw882xx_acf.bin";
		sound-name-prefix = "Speaker";
	};

	receiver_amp: audio-codec@35 {
		compatible = "awinic,aw88261";
		reg = <0x35>;

		#sound-dai-cells = <0>;
		awinic,audio-channel = <0>;
		dvdd-supply = <&pm6125_l9>;
		firmware-name = "aw882xx_acf.bin";
		sound-name-prefix = "Receiver";
	};
};

/*
 * WiFi: WCN3988, driven by ath10k over SNOC.
 *
 * The WLAN core does not run its own downloaded firmware the way the touch
 * controller does -- wifi@c800000 carries qcom,msa-fixed-perm, meaning the
 * modem has already been given access to the shared memory area. So the modem
 * has to be running first, which is why remoteproc_mpss is enabled below; the
 * bengal boards do exactly the same pairing.
 *
 * Everything needed is on the device rather than redistributable: modem.mdt
 * and wlanmdsp.mbn live in the modem partition, alongside this handset's own
 * board data as bdwlan_fogona_ipa.bin / _epa.bin. msm-firmware-loader mounts
 * that partition and links its image/ directory into the firmware search path.
 */
&wifi {
	vdd-0.8-cx-mx-supply = <&pm6125_l8>;
	vdd-1.8-xo-supply = <&pm6125_l16>;
	vdd-1.3-rfa-supply = <&pm6125_l17>;
	vdd-3.3-ch0-supply = <&pm6125_l23>;

	/*
	 * Names this board's entry in board-2.bin. ath10k asks for
	 * "bus=snoc,qmi-board-id=ff,qmi-chip-id=150,variant=Motorola_fogona"
	 * first, then the same name without the variant, then board-id alone --
	 * so this is not load-bearing here: the board-2.bin that fogona-wlan-bdf
	 * builds on the handset carries both that name and the bare board-id
	 * one, and resolves either way.
	 *
	 * Declared anyway because it is what every other qcom board in mainline
	 * does, the two closest relatives included -- sm6115-fxtec-pro1x
	 * ("Fxtec_QX1050") and sm6115p-lenovo-j606f ("Lenovo_P11"), neither of
	 * which has an entry in upstream board-2.bin either. The string is the
	 * key a board file would be submitted under if Motorola ever published a
	 * redistributable one; today it only picks the more specific of two
	 * names for the same blob.
	 */
	qcom,calibration-variant = "Motorola_fogona";

	status = "okay";
};

/*
 * Bluetooth: WCN3988, the BT half of the WiFi/BT combo, on uart3's serdev
 * bus. Rails are the same four the &wifi node above uses -- one combo chip,
 * shared RF supplies. See investigations/bluetooth.md.
 *
 * The second interrupt is the out-of-band wakeup on the RX pin, which lets
 * the controller wake the AP with the UART clocked down; omitting it is easy
 * and the symptom would be a link that works until it idles. max-speed
 * matches both the RB2 reference and a khaje sibling (Lenovo tb128fu).
 */
&uart3 {
	interrupts-extended = <&intc GIC_SPI 330 IRQ_TYPE_LEVEL_HIGH>,
			      <&tlmm 11 IRQ_TYPE_EDGE_FALLING>;
	pinctrl-0 = <&uart3_default>;
	pinctrl-1 = <&uart3_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn3988-bt";
		vddio-supply = <&pm6125_l9>;
		vddxo-supply = <&pm6125_l16>;
		vddrf-supply = <&pm6125_l17>;
		vddch0-supply = <&pm6125_l23>;
		max-speed = <3200000>;
	};
};

/*
 * No firmware-name here on purpose. The driver default for this compatible is
 * the bare "modem.mdt", which is what msm-firmware-loader links flat into the
 * firmware search path and what resolves on this handset. The nested
 * qcom/sm6225/motorola/fogona/ subtree that something else creates under that
 * root points at /mnt/modem, which is an empty directory, so every file under
 * it dangles -- naming it here is how the modem failed to load for months.
 */
&remoteproc_mpss {
	status = "okay";
};

/*
 * The modem's data path, and the reason ModemManager can build a modem object
 * at all: without it MM finishes its QMI probe and then gives up with "Failed
 * to find a net port in the QMI modem", so there is no data, no calls, and not
 * even a SIM read.
 *
 * The AP loads the GSI firmware here rather than the modem: TZ has the PAS id
 * (0xf, what downstream's pas-ids says) and msm-firmware-loader surfaces the
 * whole ipa_fws set out of the modem partition, so there is nothing to defer to
 * the modem for. pil_ipa_fw_mem is 64 KiB and the image totals ~19 KiB across
 * its five segments, so it fits with room to spare.
 *
 * No firmware-name here, for the same reason as &remoteproc_mpss above: the
 * driver default is the bare "ipa_fws.mdt", which is exactly the flat link the
 * loader creates in the firmware search root. Note the ipa_fws.mbn beside it is
 * a symlink to that same .mdt rather than a single-file image, so the split
 * .mdt + .b00..b04 path is the only one that exists on this handset.
 */
&ipa {
	memory-region = <&pil_ipa_fw_mem>;

	qcom,gsi-loader = "self";

	status = "okay";
};

/*
 * The audio DSP. Nothing in the audio subsystem exists without it: the codec
 * macros, the MI2S ports and the sound card all hang off services this
 * remoteproc publishes, and so -- less obviously -- does lpass_tlmm. The LPI
 * pin controller's only clock is an LPASS vote owned by a DSP service, so with
 * the ADSP down it is a node in the DT with no driver bound to it, and no pin
 * on the LPI block can be muxed.
 *
 * adsp.mdt and its adsp.b* segments come from the modem partition by way of
 * msm-firmware-loader, the same route modem.mdt above takes; nothing is
 * redistributed with the port. No firmware-name here, for exactly the reason
 * given at &remoteproc_mpss: adsp_resource_init already defaults to the bare
 * "adsp.mdt", which is the flat link that resolves, and the nested
 * qcom/sm6225/motorola/fogona/adsp.mdt dangles the same way modem.mdt did.
 *
 * The service layer under this node is GPR rather than APR -- see the sm6225
 * dtsi change that converted it. The distinction matters here because an ADSP
 * described the wrong way still boots and still reports "running", so this
 * node coming up is not on its own evidence that audio will work.
 */
&remoteproc_adsp {
	status = "okay";
};

/*
 * The primary MI2S bit clock, named so q6apm-lpass-dais can find it.
 *
 * This is not an ordinary clock: q6prmcc's provider is the DSP itself, so
 * clk_set_rate() here becomes a PRM command telling the ADSP how to clock the
 * LPAIF. Without it of_q6apm_parse_dai_data() leaves the port's bclk NULL,
 * q6i2s_set_sysclk() silently does nothing, and the DSP is asked to accept a
 * media format for an interface it has never been told the clock for.
 */
&q6apmbedai {
	#address-cells = <1>;
	#size-cells = <0>;

	dai@16 {
		reg = <PRIMARY_MI2S_RX>;
		clocks = <&q6prmcc LPASS_CLK_ID_PRI_MI2S_IBIT
			  LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "bclk";
	};
};

/*
 * Touchscreen: ChipOne ICNL9916C, a TDDI part that drives the panel and the
 * digitizer from one package. The touch half is on SPI SE0, which is how stock
 * has it -- its overlay's fixups resolve fragment@60's target to
 * `qupv3_se0_spi`, and the node carries spi-max-frequency = 9.6 MHz with the
 * interrupt on TLMM 80 and reset on TLMM 86.
 *
 * reg = <0>, NOT <1>, even though stock names the node chipone_tddi@1. Stock
 * declares three touch nodes on this one bus -- novatek@0, chipone_tddi@1 and
 * ilitek@2 -- for the three panel variants fogona shipped, selected at runtime
 * by matching mmi,panel_name. They cannot be three chip selects: qup_spi0's
 * pinctrl muxes a single CS (gpio3). Motorola's own driver settles it by
 * overriding whatever DT said:
 *
 *     pdata->spi_client->chip_select = 0;
 *         -- cts_platform.c, cts_plat_spi_setup()
 *
 * So the @N suffixes are variant slots, and the real chip select is 0.
 *
 * 6 MHz rather than the 9.6 MHz stock allows: that is what the vendor driver
 * actually clocks (CFG_CTS_SPI_SPEED_KHZ 6000), so it is the rate the part is
 * known to work at. Raise it once the controller is talking.
 *
 * Falling-edge interrupt matches the vendor's IRQF_TRIGGER_FALLING. The reset
 * line is active low: the driver pulses the logical line high then low, which
 * for a RESET_N pin has to invert.
 */
/*
 * The QUP wrapper gates every serial engine under it, so enabling spi0 alone
 * does nothing: geniqup@4ac0000 ships disabled, and a disabled parent means
 * of_platform never populates its children. Symptom is not a probe failure but
 * total absence -- no 4a80000.spi platform device, nothing in
 * /sys/bus/spi/devices, and not one geni line in dmesg.
 *
 * Note i2c0 and spi0 share address 0x4a80000: SE0 is one engine that is either
 * an I2C or a SPI port, never both. i2c0 must stay disabled.
 */
&qupv3_id_0 {
	status = "okay";
};

/*
 * gpi_dma0 is deliberately left disabled. spi0 lists it in `dmas`, but
 * spi-geni-qcom falls back to PIO when the channels cannot be obtained, and
 * PIO is more than enough for a touch controller whose largest transfer is a
 * 77-byte report.
 */
/*
 * The bus only. The touch controller itself is a TDDI half of the panel, so it
 * differs per panel variant and lives in the per-panel .dts alongside it --
 * stock declares novatek@0, chipone_tddi@1 and ilitek@2 on this one bus for
 * exactly that reason, picking one at runtime by mmi,panel_name.
 */
&spi0 {
	status = "okay";
};

/*
 * USB, high-speed only. fogona routes no superspeed at all (Motorola's
 * schematics break USB_CC1/CC2 out to testpoints but carry no SBU, and
 * USB0_SS_* / USB0_DP_AUX_* have no cross-sheet routing), so dwc3 is pinned to
 * the HS phy and `qcom,select-utmi-as-pipe-clk` stands in for the absent SS
 * phy's pipe clock.
 *
 * Unlike U-Boot -- which has no SMD/RPM regulator driver and therefore cannot
 * bring these rails up at all -- Linux can, which is why USB is worth enabling
 * here: it gives a console channel that does not depend on the panel.
 *
 * Rails per the PM6225 datasheet, cross-checked against the board's analog
 * rail traces (FOGONA-BOARD.md 1): vdda-pll -> L4 (VDD_A_USBHS_0P9),
 * vdda18 -> L12 (VDD_TXDAC/USB 1.8 V), vdda33 -> L15 (VDD_A_USBHS_3P1,
 * proven -- only L15A instance on the sheet).
 *
 * These property names are correct for THIS node and must not be "corrected"
 * to j606f's. sm6225.dtsi declares usb_hsphy as "qcom,usb-snps-hs-7nm-phy"
 * (phy-qcom-snps-femto-v2.c, which asks for vdda-pll/vdda33/vdda18), whereas
 * mainline sm6115.dtsi declares it as "qcom,sm6115-qusb2-phy"
 * (phy-qcom-qusb2.c, which asks for vdd/vdda-pll/vdda-phy-dpdm). Different
 * driver, different names, same three board rails.
 */
/*
 * Type-C CC logic: SGM7220 at 0x47 on QUP SE1, interrupt on GPIO 84. Wiring is
 * Motorola's, from kernel-devicetree/qcom/sgm7220.dtsi via
 * khaje-fogona-common-overlay.dtsi.
 *
 * "ti,tusb320" is not an approximation. The SGM7220 is a register-level
 * TUSB320 clone: same default address, and it returns the literal signature
 * "TUSB320" from registers 7..0, which is what tusb320_check_signature()
 * compares against. Confirmed independently by Quectel's own SGM7220 driver,
 * which checks the identical byte array -- and now on hardware, where the port
 * reports a live power_operation_mode read back over i2c.
 *
 * This exists to give dwc3 connect/disconnect events. Without a role-switch
 * provider dwc3 pulls up once at boot and can never recover a lost session --
 * observed as usb0 going DOWN with the UDC reading "not attached", and
 * unrecoverable by replugging because the VBUS event had no consumer.
 *
 * UFP-only on purpose: this handset is never a host, and vendor configures
 * Try.SNK. The role switch is here to report DEVICE and NONE.
 */
&i2c1 {
	status = "okay";

	/*
	 * Main charger. The schematic second-sources this position between an
	 * SGM41542 at 0x3B and a Southchip SC89890H at 0x6A, and the stock dtbo
	 * declares both, so the DT alone cannot say which is fitted. A bus scan
	 * settles it: 0x3B is silent, 0x6A answers, and its REG14 part-number
	 * field reads 4, which is the SC89890H's ID. Hence the Southchip
	 * compatible and not a TI one -- the part shares the bq25890 register
	 * map but not its current and boost step sizes.
	 *
	 * Without this node nothing drives the charger and it is left exactly
	 * as the bootloader hands it over, which on this unit means REG03
	 * CHG_CFG clear: VBUS present, PG good, and no charge current at all.
	 * The phone discharges on a charger. This node is what turns that
	 * around; it is not a tuning refinement.
	 *
	 * Values follow stock's bq25890@6A with one deliberate exception. Stock
	 * regulates to 4500 mV, but it pairs that with an mmi JEITA layer that
	 * drops to 4250 mV below 15 degrees and 4200 mV above 45. Mainline has
	 * no JEITA for this chip, so 4500 mV would be held at every
	 * temperature, including cold, where it risks plating the cell. 4400 mV
	 * is our battery node's voltage-max-design and is the value to use
	 * until something implements the temperature zones.
	 *
	 * No ti,use-ilim-pin: EN_ILIM is clear as the hardware is handed over,
	 * and whether this board even fits the ILIM resistor is unestablished,
	 * so enabling the pin could clamp the input somewhere arbitrary. The
	 * input limit comes from the chip's own BC1.2/auto-DPDM detection
	 * either way -- the Type-C Rp advertisement is not wired to it, and on
	 * this chip it never will be (see investigations/charging.md).
	 *
	 * The boost properties are required by the binding but unused here:
	 * the port is UFP-only and this handset is never a host.
	 */
	charger@6a {
		compatible = "southchip,sc89890h";
		reg = <0x6a>;

		interrupts-extended = <&tlmm 28 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&charger_int_n>;

		/*
		 * The Type-C port is where the real input limit comes from.
		 * The charger's own BC1.2 detection only sees D+/D-, so a
		 * laptop port advertising 3.0 A through Rp while presenting a
		 * plain SDP signature is charged at 500 mA -- measured here,
		 * with only ~65 mA of that reaching the battery because the
		 * SoC takes the rest. The SGM7220 reads the CC pins and
		 * publishes what was actually promised.
		 */
		power-supplies = <&typec>;

		/*
		 * The pack thermistor is on the gauge, not here: the schematic
		 * puts BATT_THERM on the CW2217's TS pin, and this charger's TS
		 * input sits at the top of its range as a result -- TSPCT reads
		 * 0x7F with the ADC both stopped and running, which the driver
		 * renders as -21 C while the gauge reports a correct 33 C.
		 *
		 * This only fixes what is *reported*. The chip's own JEITA
		 * derating, and the driver's cool-band derating, both key off
		 * NTC_FAULT, which comes from that same unconnected pin -- so
		 * there is still no temperature protection in the charging
		 * path. See investigations/charging.md.
		 */
		battery-temperature-supply = <&fuel_gauge>;

		ti,battery-regulation-voltage = <4400000>;
		ti,charge-current = <3000000>;
		ti,termination-current = <243000>;
		ti,precharge-current = <300000>;
		ti,minimum-sys-voltage = <3500000>;
		ti,boost-voltage = <5000000>;
		ti,boost-max-current = <1200000>;
	};

	typec: typec@47 {
		compatible = "ti,tusb320";
		reg = <0x47>;

		interrupts-extended = <&tlmm 84 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&typec_int_n>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "sink";
			data-role = "device";
			typec-power-opmode = "default";

			port {
				typec_hs: endpoint {
					remote-endpoint = <&usb_dwc3_hs>;
				};
			};
		};
	};
};

&usb_dwc3_hs {
	remote-endpoint = <&typec_hs>;
};

&usb {
	qcom,select-utmi-as-pipe-clk;
	status = "okay";
};

&usb_dwc3 {
	/*
	 * usb-role-switch is KEPT, reversing what this comment used to say.
	 *
	 * It was deleted here for good reason: sm6225.dtsi sets it, dwc3 then
	 * waits for a provider to say host-or-peripheral, and fogona had none --
	 * so the role never arrived and /sys/class/udc stayed empty even with a
	 * working phy. j606f does the same, for the same reason.
	 *
	 * The SGM7220 above is that provider now. Keeping the deletion also meant
	 * dwc3 had no connect/disconnect events at all, so a session lost to a
	 * host suspend or bus reset could never be recovered -- usb0 went DOWN
	 * with the UDC "not attached" and nothing, replugging included, brought
	 * it back. On a board whose only debug channel is this port, that is
	 * worse than the problem the deletion solved.
	 *
	 * high-speed and the usb2-phy-only phys list are NOT just inherited from
	 * j606f: this board physically cannot do SuperSpeed. USB0_SS_* and
	 * USB0_DP_AUX_* appear in the SoC pinout with no routing, the test-point
	 * bank breaks out only CC1/CC2 and the HS pair, and the eLDO in the
	 * power-on sequence gates SuperSpeed DP that is not there
	 * (FOGONA-BOARD.md 3 and 4). The SoC offers USB 3.1 and khaje-usb.dtsi
	 * asks for "super-speed", but khaje is the SoC, not this handset.
	 *
	 * So do not "restore" SuperSpeed here. usb_qmpphy is already disabled in
	 * sm6225.dtsi and must stay that way; ABL still leaves its clocks
	 * running, which is why gcc_usb3_prim_phy_* show up hardware-enabled
	 * with no consumer in clk_summary. Those are safe to gate -- they feed a
	 * PHY whose outputs go nowhere.
	 */
	maximum-speed = "high-speed";
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
	/*
	 * "otg", not "peripheral", and this is load-bearing rather than scope
	 * creep. dwc3 calls dwc3_drd_init() -- and therefore
	 * dwc3_setup_role_switch() -> usb_role_switch_register() -- ONLY under
	 * case USB_DR_MODE_OTG. With "peripheral" no role switch is registered,
	 * so the tusb320's fwnode_usb_role_switch_get() returns -EPROBE_DEFER
	 * forever and the chip never binds. Measured exactly that: 0-0047 sat on
	 * /sys/kernel/debug/devices_deferred, driver registered and device
	 * present but unbound, while USB still worked because "peripheral"
	 * forces device mode on its own.
	 *
	 * This does not make the handset a host. dwc3_setup_role_switch()
	 * defaults role_switch_default_mode to PERIPHERAL and sets
	 * DWC3_GCTL_PRTCAP_DEVICE at probe unless role-switch-default-mode says
	 * "host", so the gadget comes up at boot before any CC event.
	 */
	dr_mode = "otg";
	role-switch-default-mode = "peripheral";
};

&usb_hsphy {
	vdda-pll-supply = <&pm6125_l4>;
	vdda18-supply = <&pm6125_l12>;
	vdda33-supply = <&pm6125_l15>;
	status = "okay";
};

/*
 * The whole Adreno block is off for this bringup, and that is a deliberate
 * noise-reduction measure as much as a scope one.
 *
 * gpu / gmu_wrapper / adreno_smmu are the only consumers of &gpucc, and
 * adreno_smmu@59a0000 is the ONLY iommu in sm6225.dtsi with a clocks property.
 * Left enabled without gpucc it fails as
 *   arm-smmu 59a0000.iommu: probe failed -110
 * and emits "supplier <addr>.clock-controller not ready", which reads exactly
 * like a storage problem and is not one: ufs_mem_hc's iommu is
 * apps_smmu@c600000, which has no clocks at all. Disabling these three removes
 * that entire false trail.
 *
 * The GPU is also not reachable yet for an unrelated reason: A610 needs
 * a610_zap.mdt and a630_sqe.fw, and mainline's A610 speedbin table is
 * bengal-only with no khaje entry (see SM6225.md).
 */
/*
 * Display. The bootloader lights the panel and simple-framebuffer above shows
 * it, but that is a static buffer -- no modesetting, no backlight, no power
 * management. This wires up the real pipeline: MDSS/DPU -> DSI0 -> the panel.
 *
 * simple-framebuffer is deliberately left in place. msm_kms calls
 * aperture_remove_all_conflicting_devices() when KMS comes up, so simpledrm is
 * evicted automatically once this works, and survives as a usable console if
 * it does not.
 *
 * Panel power. The Tianma module wants three rails, named as its own bindings
 * name them rather than as the vendor's dsi_panel_pwr_supply does:
 *
 *   vddio -> VREG_L9A       (1.8 V logic, always-on -- see above)
 *   avdd  -> lcd_panel_avdd (vendor "lab",  +5.9 V, gated by TLMM 111)
 *   avee  -> lcd_panel_avee (vendor "ibb",  -5.9 V, gated by PM6125 GPIO2)
 *
 * The two 5.9 V rails are not PMIC LDOs: they come from a bias chip enabled by
 * a GPIO, so they are fixed regulators here. Both are boot-on because the
 * bootloader has already brought the panel up.
 */
/ {
	lcd_panel_avdd: regulator-lcd-avdd {
		compatible = "regulator-fixed";
		regulator-name = "lcd_panel_avdd";
		regulator-min-microvolt = <5900000>;
		regulator-max-microvolt = <5900000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 111 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;

		/*
		 * Deliberately NO pinctrl-0. This node used to carry
		 * `pinctrl-0 = <&panel_avdd_default>`, a group that muxes the
		 * same GPIO_111 this regulator drives. On 6.14 that was
		 * tolerated; on 7.3 pinctrl refuses to claim a pin a GPIO
		 * consumer already holds, and the whole probe fails:
		 *
		 *   sm6225-tlmm 500000.pinctrl: pin GPIO_111 already requested
		 *     by regulator-lcd-avdd; cannot claim for 500000.pinctrl:623
		 *   reg-fixed-voltage regulator-lcd-avdd: error -EINVAL:
		 *     can't get GPIO
		 *
		 * That took the panel down with it -- the DSI host sat in
		 * "deferred probe pending: supplier regulator-lcd-avdd not
		 * ready" forever, so no connector, no card1-DSI-1, and the
		 * unused-regulator sweep then switched lcd_panel_avee off at
		 * ~31 s, which is the backlight going out.
		 *
		 * lcd_panel_avee below is the proof of the right shape: it has
		 * a gpio and no pinctrl-0, and it probes. Requesting a TLMM pin
		 * as a GPIO already muxes it to the gpio function, so the group
		 * only ever added drive-strength/bias -- not worth the probe.
		 */
	};

	lcd_panel_avee: regulator-lcd-avee {
		compatible = "regulator-fixed";
		regulator-name = "lcd_panel_avee";
		regulator-min-microvolt = <5900000>;
		regulator-max-microvolt = <5900000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&pm6125_gpios 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};
};

&mdss {
	status = "okay";
};

/*
 * The DSI host only. fogona is dual-sourced, so the panel node itself lives in
 * the per-panel .dts that includes this file.
 */
&mdss_dsi0 {
	/* L18 is fixed at 1.232 V for the DSI PHY; it is also UFS's vdda-pll. */
	vdda-supply = <&pm6125_l18>;
	status = "okay";
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	status = "okay";
};

/*
 * The Adreno 610 is what makes this a usable phone: phoc builds its renderer on
 * it, and with the GPU off Turnip cannot find a device ("could not get GPU ID"),
 * wlroots fails both its Vulkan and GLES paths, the greeter exits without
 * creating a session, and greetd crash-loops into systemd's start limit. The
 * panel stays lit with nothing drawing on it, which reads as a display bug and
 * is not one.
 *
 * These were left disabled while the GPU was the thing under investigation, and
 * that made sense when every image was hand-built with them flipped on. It stops
 * making sense now that the device assembles its own boot image from the
 * packaged DTB (fogona-mkboot), because the default is what ships.
 *
 * Known cost, deliberately accepted: sustained load at the top OPPs still
 * produces a6xx_irq faults and hangcheck recoveries, and eventually a hard crash
 * to the bootloader -- see /repo/investigations/gpu-adreno610.md. A phone that
 * can fault under load beats a phone with no session at all.
 */
&gpu {
	status = "okay";
};

&gmu_wrapper {
	status = "okay";
};

/*
 * The venus driver's default for this compatible is
 * "qcom/venus-6.0/venus.mbn", a path nothing on this rootfs provides.
 * msm-firmware-loader assembles the vendor partition's firmware into a flat
 * directory and points the kernel's search path at it
 * (/sys/module/firmware_class/parameters/path), so the image is simply
 * "venus.mbn" -- extracted from modem_a/image, 0x700000 of loadable segments,
 * which is what pil_video_mem is now sized and placed for.
 *
 * This belongs on the board rather than in sm6225.dtsi because it describes
 * where *this* rootfs puts firmware, not where the SoC keeps it.
 *
 * Enabled: iris brings the core up on this firmware -- SYS_INIT completes and
 * the firmware answers HFI_PROP_IMAGE_VERSION. Both drivers match this node's
 * "qcom,sm6225-venus" compatible, so exactly one of them may be loaded;
 * /etc/modprobe.d/fogona-video.conf in the device package blacklists venus_core
 * and leaves qcom_iris to bind.
 */
&venus {
	firmware-name = "venus.mbn";
	status = "okay";
};

&adreno_smmu {
	status = "okay";
};

/*
 * Camera.
 *
 * fogona has two sensors, not three: a 50 MP Samsung S5KJN1 on CCI bus 0 /
 * CSIPHY 0, and an 8 MP front sensor (S5K4H7, or OV08F on the TS-Precision
 * second source) on CCI bus 1 / CSIPHY 2. The schematic's OV02D10 macro camera
 * is a position that is not populated -- the shipping dtbo, the downstream
 * camera DT and the vendor sensormodule blobs all describe exactly these two.
 * Only the rear one is wired up here, because the front sensor has no mainline
 * driver and nothing downstream to port from: on Qualcomm CAMSS the kernel
 * drives CCI/CSIPHY/CSID/TFE and the *sensor* is driven from userspace, so
 * Motorola shipped no sensor driver for either part. Its rails are declared
 * anyway, so adding the sensor later is a node and not an archaeology session.
 *
 * Every camera rail is a discrete GPIO-gated LDO -- there is no camera PMIC on
 * this board, which is why these are regulator-fixed rather than an entry in
 * the RPM block above. The _50m_/_8m_ names are Motorola's own and say which
 * sensor each belongs to.
 *
 * As with lcd_panel_avdd, NONE of these carries a pinctrl-0 naming the pin it
 * drives: requesting a TLMM pin as a GPIO already muxes it to the gpio
 * function, and a pinctrl group over the same pin makes the regulator fail to
 * probe on 7.3.
 */
/ {
	camera_ldo_iovdd: regulator-cam-iovdd {
		compatible = "regulator-fixed";
		regulator-name = "camera_ldo_iovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	camera_ldo_50m_avdd: regulator-cam-50m-avdd {
		compatible = "regulator-fixed";
		regulator-name = "camera_ldo_50m_avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	camera_ldo_50m_dvdd: regulator-cam-50m-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "camera_ldo_50m_dvdd";
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 65 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* The rear module's autofocus actuator. */
	camera_ldo_50m_afvdd: regulator-cam-50m-afvdd {
		compatible = "regulator-fixed";
		regulator-name = "camera_ldo_50m_afvdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	camera_ldo_8m_avdd: regulator-cam-8m-avdd {
		compatible = "regulator-fixed";
		regulator-name = "camera_ldo_8m_avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 68 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The one camera rail not gated by a TLMM pin. The board doc's PMIC
	 * GPIO map calls PM6125 GPIO_01 "Front_DVDD_EN" independently of the
	 * downstream camera DT pointing it at the front sensor's digital core,
	 * which is a pleasant cross-confirmation of both.
	 */
	camera_ldo_8m_dvdd: regulator-cam-8m-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "camera_ldo_8m_dvdd";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&pm6125_gpios 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * Camera flash and torch, which needs none of the CAMSS stack above:
	 * it is a two-pin charge pump and an existing driver.
	 *
	 * The fitted part is an OCP8135 (OCS) or an SGM3785 (SGMICRO), not an
	 * I2C device -- ENF selects flash vs movie/torch and ENM enables it.
	 * leds-sgm3140 matches ocs,ocp8110 and sgmicro,sgm3140, the same
	 * two-level charge-pump family, and its torch sequence (flash_gpio low,
	 * then enable_gpio high) is the OCP8135 truth table in order.
	 *
	 * Downstream drives ENM from pm6125_pwm channel 0 for brightness
	 * control. Mainline has no pm6125 LPG/PWM support and the driver only
	 * ever wants the pin fully on, so it is a plain GPIO here -- the same
	 * thing already proven on PM6125 gpio2 (panel AVEE) and gpio5 (volume
	 * up). The bootloader leaves gpio8 muxed as PWM ("out low func1" in
	 * /sys/kernel/debug/gpio); requesting it as a GPIO re-muxes it.
	 *
	 * Beware the net name: the trace driving ENM is called HAPTIC_PWM on
	 * the schematic and has nothing to do with the vibrator.
	 */
	led-controller {
		compatible = "ocs,ocp8110";
		flash-gpios = <&tlmm 85 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&pm6125_gpios 8 GPIO_ACTIVE_HIGH>;

		led {
			function = LED_FUNCTION_FLASH;
			color = <LED_COLOR_ID_WHITE>;
			flash-max-timeout-us = <250000>;
		};
	};
};

/*
 * L4A is VDD_A_CSI_0/1/2_0P9 and L18A is VDD_A_CSI_0/1/2_1P2 -- the board doc
 * reads both straight off the schematic, and the downstream CSIPHY nodes agree
 * (mipi-csi-vdd1 at 0.88-1.05 V, mipi-csi-vdd2 at 1.2-1.3 V). Note L18A is
 * shared with the DSI PHY and UFS's vdda-pll; the regulator core refcounts it.
 */
&camss {
	vdd-csiphy-0p9-supply = <&pm6125_l4>;
	vdd-csiphy-1p2-supply = <&pm6125_l18>;

	status = "okay";

	ports {
		port@0 {
			csiphy0_ep: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&s5kjn1_ep>;
			};
		};
	};
};

&cci {
	status = "okay";
};

&cci_i2c0 {
	/*
	 * An S5KJNS, not the S5KJN1 the module part number suggests: the
	 * silicon reports model id 0x38ee and the vendor's own sensormodule
	 * blob declares the same. It shares the S5KJN1's register map -- the
	 * driver's mode tables drive it and it streams -- so it is the same
	 * driver under a second compatible.
	 *
	 * Otherwise the upstream binding's own example is camera@56 with 2.8 V
	 * vdda, 1.05 V vddd, 1.8 V vddio and a 2.8 V autofocus rail -- field
	 * for field this module. The driver rejects any MCLK that is not
	 * exactly 24 MHz and any lane count that is not 4, both of which match.
	 *
	 * power-domains is not decoration: s5kjn1_power_on() runs at probe to
	 * read CHIP_ID, and the MCLK branch it enables is inside the CAMSS top
	 * GDSC -- downstream says as much by listing that GDSC as the sensor's
	 * "cam_clk" supply. Without it the clock does not actually toggle and
	 * the sensor never answers.
	 */
	camera@56 {
		compatible = "samsung,s5kjns";
		reg = <0x56>;

		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
		assigned-clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
		assigned-clock-rates = <24000000>;
		power-domains = <&gcc GCC_CAMSS_TOP_GDSC>;

		pinctrl-0 = <&cam_mclk0_default>;
		pinctrl-names = "default";

		reset-gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;

		vdda-supply = <&camera_ldo_50m_avdd>;
		vddd-supply = <&camera_ldo_50m_dvdd>;
		vddio-supply = <&camera_ldo_iovdd>;
		afvdd-supply = <&camera_ldo_50m_afvdd>;

		port {
			s5kjn1_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <700000000>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};
};
