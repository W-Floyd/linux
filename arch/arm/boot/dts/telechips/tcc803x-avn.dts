// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
/*
 * Minimal example board: Telechips TCC803x "AVN" (Audio Video Navigation)
 * automotive head-unit class.
 *
 * AVN as a real board class for this SoC is confirmed in vendor source:
 *   arch/arm/configs/tcc803x_android_avn_defconfig:413 (CONFIG_PLATFORM_AVN=y)
 * (path relative to AVNT5W_TCC803XKK_kernel/, see tcc803x.dtsi for the
 * full reference-tree note). No vendor .dts is literally named
 * "tcc803x-avn" -- real AVN board .dts files in that tree are named for
 * sibling chips in the family (tcc8970/tcc8971/tcc8031). This file is a
 * from-scratch placeholder board using the generic SoC name, not a port
 * of any specific vendor board file.
 *
 * Everything board-specific below (model string, memory size, UART
 * enablement) is a placeholder pending a real schematic/board reference.
 */

/dts-v1/;

#include "tcc803x.dtsi"

/ {
	model = "Telechips TCC803x AVN";
	compatible = "telechips,tcc803x-avn", "telechips,tcc803x";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		/*
		 * Baud confirmed: vendor tcc803x.dtsi:29-30 (bootargs
		 * console=ttyAMA0,115200n8).
		 */
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Component-master glue (drivers/gpu/drm/telechips/tcc803x_drm_drv.c)
	 * walks this "ports" phandle list positionally (drm_of_component_match_add()),
	 * not by compatible string. Only &vioc_crtc0 is listed: it is the only
	 * block that actually calls component_add() (tcc803x_drm_vioc.c).
	 *
	 * hdmi_tx is NOT listed here. Its driver
	 * (drivers/gpu/drm/bridge/tcc803x-dw-hdmi.c) is a DRM bridge, not a
	 * component - it registers via dw_hdmi_probe()/drm_bridge_add() and
	 * never calls component_add(), so a phandle in this match set would
	 * never be satisfied and component_bind_all() would wait on it
	 * forever. Instead, tcc803x_drm_vioc.c's ->bind() resolves hdmi_tx
	 * through the vioc_crtc0/hdmi_tx OF-graph "port"/"endpoint" pair in
	 * tcc803x.dtsi (devm_drm_of_get_bridge()) and calls
	 * drm_bridge_attach() directly on its own CRTC-owned encoder - the
	 * standard mainline pattern for a bridge behind a component CRTC
	 * (cf. drivers/gpu/drm/mxsfb/lcdif_drv.c's lcdif_attach_bridge()).
	 */
	display: display-subsystem {
		compatible = "telechips,tcc803x-display-subsystem";
		ports = <&vioc_crtc0>;
	};

	/*
	 * MRGB (synchronous parallel-RGB) panel output: structural only.
	 * Not in the "ports" component-match list above, and not OF-graph
	 * connected to vioc_crtc0's own port/endpoint (that endpoint is
	 * already paired 1:1 with hdmi_tx_in in tcc803x.dtsi; DISP0 is
	 * understood to feed HDMI and MRGB simultaneously on real hardware,
	 * but no driver here resolves a second, MRGB-side consumer yet, so
	 * adding a second endpoint would describe a connection nothing
	 * acts on). See Documentation/devicetree/bindings/display/
	 * telechips/telechips,tcc803x-mrgb-panel.yaml for what is and is
	 * not confirmed about this path -- notably, VIOC_OUTCFG_MRGB is
	 * never called by any vendor driver found in
	 * AVNT5W_TCC803XKK_kernel, and the only other same-resolution
	 * panel in that vendor tree is LVDS, off the same DISP0 this node
	 * uses (not DISP1 as an earlier pass claimed -- that board's own
	 * dts carries zero DISP overrides; it includes the real AVN
	 * board's base dtsi unmodified, whose fbdisplay node is
	 * fbdisplay_num=0). LVDS has a complete vendor driver, an on-die
	 * PHY (lvds_phy@12370000 in tcc803x.dtsi), and the real AVN
	 * board's own pinctrl names lvds_variant_check-gpio alongside
	 * digital_variant_check-gpio -- real vendor source leans LVDS over
	 * MRGB for the actual panel, even though this node stays MRGB
	 * pending live confirmation (see the binding's caveat section).
	 * This node exists so the real, live-captured DISP0 timing has
	 * somewhere honest to live, not as a claim that an MRGB pipeline
	 * works end to end.
	 */
	mrgb_panel: panel {
		compatible = "telechips,tcc803x-mrgb-panel";
		width-mm = <92>;
		height-mm = <243>;

		panel-timing {
			hactive = <1920>;
			vactive = <720>;
			hsync-len = <31>;
			hfront-porch = <49>;
			hback-porch = <159>;
			vsync-len = <4>;
			vfront-porch = <14>;
			vback-porch = <27>;
			/*
			 * clock-frequency intentionally omitted -- see the
			 * binding's description for why this is a tracked
			 * gap, not an oversight. A dtbs_check run against
			 * mainline's generic panel-timing.yaml (which lists
			 * clock-frequency as required) will flag this node;
			 * that failure is expected until the real pixel
			 * clock is known, not a sign this node is wrong.
			 */
		};
	};
};

&uart0 {
	status = "okay";
};

/*
 * eMMC enablement confirmed: vendor mobis/tcc8031-android-avn.dtsi:
 * 797-815 (sdhc@16440000 override -- the TCC8031-based AVN board this
 * SoC family's real AVN boards are built on). vendor fstab path
 * "/dev/block/platform/16440000.sdhc/..." (mobis/tcc803x-android.dtsi:53)
 * independently confirms sdhc0 (0x1644_0000) is the eMMC boot device,
 * matching the "eMMC Boot" comment on sdhc0 in tcc803x.dtsi.
 *
 * bus-width, max-frequency, non-removable, disable-wp, cap-mmc-hw-reset,
 * mmc-ddr-1_8v: vendor values at the cited lines, carried over unchanged.
 * Omitted from the vendor block: pinctrl-0 (&sd0_clk/&sd0_cmd/&sd0_bus8,
 * no pinctrl binding/driver exists yet), vqmmc-supply (&vqmmc_emmc, no
 * regulator node defined here), tcc-mmc-reset (&gpsd0 14 0, no GPIO
 * controller node defined here), and the vendor-internal tcc-kpanic /
 * no-sdio / no-sd properties (kernel-panic-dump and mode-restriction
 * flags private to the vendor driver, not part of this binding).
 */
&sdhc0 {
	status = "okay";
	bus-width = <8>;
	max-frequency = <198000000>;
	non-removable;
	disable-wp;
	cap-mmc-hw-reset;
	mmc-ddr-1_8v;
};

/*
 * HDMI enablement: the real active AVN board DT in the vendor tree
 * (arch/arm/boot/dts/mobis/tcc8031-android-avn.dtsi:285-295, TCC8031 being
 * this SoC family's real AVN silicon) sets hdmi_ref_src_clock = <0> (XIN)
 * and hdmi_phy_type = <0> (PHY 8980), matching here. This is the only
 * realistic debug/console-replacement output path on hardware with no
 * accessible UART header, so it is enabled by default on this board file
 * (unlike sdhc0 above, which mirrors the vendor's own disabled-by-default
 * SoC dtsi and is opted in per board).
 */
&hdmi_tx {
	status = "okay";
	telechips,ref-clock-source = <0>;
	telechips,phy-type = <0>;
};

/*
 * VIOC single-plane path: RDMA0 -> WMIX0/DISP0 -> hdmi_tx. See
 * tcc803x.dtsi's vioc-config/vioc-rdma0/vioc-crtc0 nodes for register
 * citations and what's deliberately not modeled.
 */
&vioc_config {
	status = "okay";
};

&vioc_rdma0 {
	status = "okay";
};

&vioc_crtc0 {
	status = "okay";
};

/*
 * External USB-A host port: forced host-only (dr_mode), see dwc_otg's
 * comment in tcc803x.dtsi for why device mode is physically unreachable
 * on this connector. Enabled here as the board's intended debug-console
 * path once no UART header is accessible -- plug a USB-to-TTL adapter
 * (CP2102/CH340/FTDI-class) into this port and add
 * "console=ttyUSB0,115200" (or ttyACM0 for a CDC-ACM adapter) to the
 * kernel command line; see arch/arm/configs/multi_v7_defconfig's
 * CONFIG_USB_SERIAL_* selections.
 *
 * status = "okay" here is a statement of board intent, not a claim this
 * path is verified end-to-end: dwc_otg's clocks/clock-names are still
 * unmodeled (see its comment) and dwc_otg_phy has no mainline driver
 * yet, so a dtbs_check run against this node is expected to fail on the
 * missing required clocks property until that driver work lands. Not
 * reverted to "disabled" because the gap is in clock/PHY driver
 * support, not in this node's own correctness -- same treatment as
 * mrgb_panel's deliberately-omitted clock-frequency above.
 */
&dwc_otg {
	status = "okay";
	dr_mode = "host";
};
