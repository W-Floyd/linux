/*
 * Minimal example board: Telechips TCC803x "AVN" (Audio Video Navigation)
 * automotive head-unit class.
 *
 * AVN as a real board class for this SoC is confirmed in vendor source:
 *   arch/arm/configs/tcc803x_android_avn_defconfig:413 (CONFIG_PLATFORM_AVN=y)
 * (path relative to AVNT5W_TCC803XKK_kernel/, see tcc803x.dtsi for the
 * full reference-tree note). No vendor .dts is literally named
 * "tcc803x-avn" -- real AVN board .dts files in that tree are named for
 * sibling chips in the family (tcc8970/tcc8971/tcc8031). This file is a
 * from-scratch placeholder board using the generic SoC name, not a port
 * of any specific vendor board file.
 *
 * Everything board-specific below (model string, memory size, UART
 * enablement) is a placeholder pending a real schematic/board reference.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "tcc803x.dtsi"

/ {
	model = "Telechips TCC803x AVN";
	compatible = "telechips,tcc803x-avn", "telechips,tcc803x";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
	};

	chosen {
		/*
		 * Baud confirmed: vendor tcc803x.dtsi:29-30 (bootargs
		 * console=ttyAMA0,115200n8).
		 */
		stdout-path = "serial0:115200n8";

		/*
		 * The panel's scanout buffer the stock firmware leaves running:
		 * RDMA0 page 0 (the decompressor points RDMA0 BASE0 at it), the
		 * 1920x720 ARGB8888 layer behind the LVDS serializer.
		 */
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		framebuffer@88000000 {
			compatible = "simple-framebuffer";
			reg = <0x88000000 0x546000>;
			width = <1920>;
			height = <720>;
			stride = <7680>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Component-master glue (drivers/gpu/drm/telechips/tcc803x_drm_drv.c)
	 * walks this "ports" phandle list positionally (drm_of_component_match_add()),
	 * not by compatible string. Only &vioc_crtc0 is listed: it is the only
	 * block that actually calls component_add() (tcc803x_drm_vioc.c).
	 *
	 * hdmi_tx is NOT listed here. Its driver
	 * (drivers/gpu/drm/bridge/tcc803x-dw-hdmi.c) is a DRM bridge, not a
	 * component - it registers via dw_hdmi_probe()/drm_bridge_add() and
	 * never calls component_add(), so a phandle in this match set would
	 * never be satisfied and component_bind_all() would wait on it
	 * forever. Instead, tcc803x_drm_vioc.c's ->bind() resolves hdmi_tx
	 * through the vioc_crtc0/hdmi_tx OF-graph "port"/"endpoint" pair in
	 * tcc803x.dtsi (devm_drm_of_get_bridge()) and calls
	 * drm_bridge_attach() directly on its own CRTC-owned encoder - the
	 * standard mainline pattern for a bridge behind a component CRTC
	 * (cf. drivers/gpu/drm/mxsfb/lcdif_drv.c's lcdif_attach_bridge()).
	 */
	display: display-subsystem {
		compatible = "telechips,tcc803x-display-subsystem";
		ports = <&vioc_crtc0>;
	};

	/*
	 * MRGB (synchronous parallel-RGB) panel output: structural only.
	 * Not in the "ports" component-match list above, and not OF-graph
	 * connected to vioc_crtc0's own port/endpoint (that endpoint is
	 * already paired 1:1 with hdmi_tx_in in tcc803x.dtsi; DISP0 is
	 * understood to feed HDMI and MRGB simultaneously on real hardware,
	 * but no driver here resolves a second, MRGB-side consumer yet, so
	 * adding a second endpoint would describe a connection nothing
	 * acts on). See Documentation/devicetree/bindings/display/
	 * telechips/telechips,tcc803x-mrgb-panel.yaml for what is and is
	 * not confirmed about this path -- notably, VIOC_OUTCFG_MRGB is
	 * never called by any vendor driver found in
	 * AVNT5W_TCC803XKK_kernel, and the only other same-resolution
	 * panel in that vendor tree is LVDS, off the same DISP0 this node
	 * uses (not DISP1 as an earlier pass claimed -- that board's own
	 * dts carries zero DISP overrides; it includes the real AVN
	 * board's base dtsi unmodified, whose fbdisplay node is
	 * fbdisplay_num=0). LVDS has a complete vendor driver and an on-die
	 * PHY (lvds_phy@12370000 in tcc803x.dtsi). Its CKC_PCLKCTRL gate
	 * (PERI_LVDS_PHY, clock ID 105) read EN=1/SEL=XIN on a live
	 * register capture off the real running unit -- the LVDS PHY's
	 * clock is actually enabled right now, not just present in source.
	 * (lvds_variant_check-gpio/digital_variant_check-gpio, named
	 * alongside each other in the real board's pinctrl, turned out to
	 * be camera-link variant detection -- drivers/misc/mobis/
	 * daudio_pinctrl.c:608-617 -- not display-panel detection; a live
	 * read of both returned 0/0 and doesn't bear on this question.)
	 * Real vendor source + live clock-gate evidence both lean LVDS over
	 * MRGB for the actual panel, even though this node stays MRGB
	 * pending live confirmation that DISP0's pixel stream actually
	 * reaches the panel through lvds_phy (see the binding's caveat
	 * section). This node exists so the real, live-captured DISP0
	 * timing has somewhere honest to live, not as a claim that an MRGB
	 * pipeline works end to end.
	 */
	mrgb_panel: panel {
		compatible = "telechips,tcc803x-mrgb-panel";
		width-mm = <92>;
		height-mm = <243>;

		panel-timing {
			hactive = <1920>;
			vactive = <720>;
			hsync-len = <31>;
			hfront-porch = <49>;
			hback-porch = <159>;
			vsync-len = <4>;
			vfront-porch = <14>;
			vback-porch = <27>;
			/*
			 * clock-frequency intentionally omitted -- see the
			 * binding's description for why this is a tracked
			 * gap, not an oversight. A dtbs_check run against
			 * mainline's generic panel-timing.yaml (which lists
			 * clock-frequency as required) will flag this node;
			 * that failure is expected until the real pixel
			 * clock is known, not a sign this node is wrong.
			 */
		};
	};
};

&uart0 {
	status = "okay";
};

/*
 * The BCM4359 combo chip's Bluetooth: an HCI UART, hardware flow control,
 * 115200 for the patch download. BT_RESET is gpc 13 (32 + 29 + 13 = pin 74),
 * which hci_bcm holds low until the controller is opened. No BT_REG_ON or
 * wake lines on this unit. The patch RAM (the stock bcm4349.hcd) is the
 * userspace's to supply: brcm/BCM4349B1.hcd or brcm/BCM.hcd.
 */
&uart1 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4349-bt";
		shutdown-gpios = <&pinctrl 74 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * The GNSS receiver (vendor ttyTCC3, /dev/ttyGPS0 to the stock HAL), 115200 8N1.
 * Only the port is enabled: the receiver's power and reset lines (gpg-4
 * GPS_ANT_PWR_ON, gpa-26 GPS_RESET_N, polarity per hardware revision) are not
 * driven, so after a kexec from Android the chip is read as the stock left it.
 * The stock HAL speaks a binary protocol on it ("hippo"), not NMEA.
 */
&uart3 {
	status = "okay";
};

/*
 * The Mali-G51. Enabled on purpose, though nothing in the vendor sources powers
 * or resets the block: if its registers are not reachable, the first read at
 * probe stalls the bus and the unit resets back to the stock Android.
 */
&gpu {
	status = "okay";
};

/* The link to the micom, which resets the SoC unless userspace answers it. */
&uart2 {
	status = "okay";
};

/*
 * eMMC enablement confirmed: vendor mobis/tcc8031-android-avn.dtsi:
 * 797-815 (sdhc@16440000 override -- the TCC8031-based AVN board this
 * SoC family's real AVN boards are built on). vendor fstab path
 * "/dev/block/platform/16440000.sdhc/..." (mobis/tcc803x-android.dtsi:53)
 * independently confirms sdhc0 (0x1644_0000) is the eMMC boot device,
 * matching the "eMMC Boot" comment on sdhc0 in tcc803x.dtsi.
 *
 * bus-width, max-frequency, non-removable, disable-wp, cap-mmc-hw-reset,
 * mmc-ddr-1_8v: vendor values at the cited lines, carried over unchanged.
 * Omitted from the vendor block: pinctrl-0 (&sd0_clk/&sd0_cmd/&sd0_bus8,
 * no pinctrl binding/driver exists yet), vqmmc-supply (&vqmmc_emmc, no
 * regulator node defined here), tcc-mmc-reset (&gpsd0 14 0, no GPIO
 * controller node defined here), and the vendor-internal tcc-kpanic /
 * no-sdio / no-sd properties (kernel-panic-dump and mode-restriction
 * flags private to the vendor driver, not part of this binding).
 */
&sdhc0 {
	status = "okay";
	bus-width = <8>;
	max-frequency = <198000000>;
	non-removable;
	disable-wp;
	cap-mmc-hw-reset;
	mmc-ddr-1_8v;
};

/*
 * HDMI: real, vendor-confirmed wiring (hdmi_ref_src_clock = <0> / XIN,
 * hdmi_phy_type = <0> / PHY 8980, arch/arm/boot/dts/mobis/
 * tcc8031-android-avn.dtsi:285-295). Left disabled by default on THIS
 * board file for now: devm_drm_of_get_bridge(dev, dev->of_node, 0, 0)
 * in tcc803x_drm_vioc.c's tcc803x_vioc_attach_bridge() resolves exactly
 * one bridge off vioc_crtc0's single output endpoint (port 0, endpoint
 * 0) -- it does not walk or chain multiple bridges, so HDMI and the
 * LVDS bridge below cannot both be the live target of that endpoint at
 * once without a driver change. LVDS is wired live below instead for
 * this kexec test pass, since exercising that untested path is the
 * point of this round of bring-up. To go back to testing HDMI: set
 * status="okay" here (with the properties below) and remove the
 * &vioc_crtc0_out override below so vioc_crtc0_out keeps its
 * tcc803x.dtsi default (&hdmi_tx_in).
 */
&hdmi_tx {
	status = "disabled";
	telechips,ref-clock-source = <0>;
	telechips,phy-type = <0>;
};

/*
 * LVDS: wired live for this kexec test pass (see &hdmi_tx above for
 * why only one of HDMI/LVDS can be live at a time). Panel referenced
 * structurally only (telechips,tcc803x-lvds-panel.yaml) -- see
 * drivers/gpu/drm/bridge/tcc803x-lvds.c for why this bridge does not
 * chain to it. clk and the 4 register regions are real
 * (tcc803x.dtsi's lvds_phy node); PHY-level register init is NOT
 * implemented by that driver -- see its header for why.
 */
&lvds_phy {
	status = "okay";
};

&vioc_crtc0_out {
	remote-endpoint = <&lvds_phy_in>;
};

&lvds_phy_in {
	remote-endpoint = <&vioc_crtc0_out>;
};

/ {
	lvds_panel: lvds-panel {
		compatible = "telechips,tcc803x-lvds-panel";
		width-mm = <92>;
		height-mm = <243>;

		panel-timing {
			hactive = <1920>;
			vactive = <720>;
			hsync-len = <31>;
			hfront-porch = <49>;
			hback-porch = <159>;
			vsync-len = <4>;
			vfront-porch = <14>;
			vback-porch = <27>;
		};
	};
};

/*
 * VIOC single-plane path: RDMA0 -> WMIX0/DISP0 -> lvds_phy (this build)
 * or hdmi_tx (see above). See tcc803x.dtsi's vioc-config/vioc-rdma0/
 * vioc-crtc0 nodes for register citations and what's deliberately not
 * modeled.
 */
&vioc_config {
	status = "okay";
};

&vioc_rdma0 {
	status = "okay";
};

&vioc_crtc0 {
	status = "okay";
};

/*
 * External USB-A host port: forced host-only (dr_mode), see dwc_otg's
 * comment in tcc803x.dtsi for why device mode is physically unreachable
 * on this connector. Enabled here as the board's intended debug-console
 * path once no UART header is accessible -- plug a USB-to-TTL adapter
 * (CP2102/CH340/FTDI-class) into this port and add
 * "console=ttyUSB0,115200" (or ttyACM0 for a CDC-ACM adapter) to the
 * kernel command line; see arch/arm/configs/multi_v7_defconfig's
 * CONFIG_USB_SERIAL_* selections.
 *
 * status = "okay" here is a statement of board intent, not a claim this
 * path is verified end-to-end: dwc_otg's clocks/clock-names are still
 * unmodeled (see its comment) and dwc_otg_phy has no mainline driver
 * yet, so a dtbs_check run against this node is expected to fail on the
 * missing required clocks property until that driver work lands. Not
 * reverted to "disabled" because the gap is in clock/PHY driver
 * support, not in this node's own correctness -- same treatment as
 * mrgb_panel's deliberately-omitted clock-frequency above.
 */
/*
 * The OTG core stays disabled: on this board the USB-A port is run in host
 * mode through the EHCI/OHCI pair behind the mux (vendor registers: OTG core
 * idle in device mode, HPRT0 = 0 with a stick plugged in), and a host-mode
 * dwc2 here only finds a bogus full-speed device and could disturb the mux.
 */
&dwc_otg {
	status = "disabled";
};

&ehci_mux {
	status = "okay";
};

&ohci_mux {
	status = "okay";
};

&ehci_host {
	status = "okay";
};

&ohci_host {
	status = "okay";
};

&i2c1 {
	status = "okay";

	/*
	 * FocalTech FT7251 touch controller (vendor log: chip id 0x7251, fw 7,
	 * 5 points, 1920x720), behind the display SerDes. No reset-gpios on
	 * purpose: its firmware carries the panel's init code and the SerDes
	 * link is already up, so probing must not reset it. The interrupt is
	 * the vendor's gpsd1 9, which the vendor kernel's external-interrupt
	 * block routes to GIC 35 (SPI 3); polarity/edge as that block left it.
	 */
	touchscreen@38 {
		compatible = "focaltech,ft7251";
		reg = <0x38>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
		touchscreen-size-x = <1920>;
		touchscreen-size-y = <720>;
	};
};

/*
 * Onboard Broadcom/Cypress BCM4359 Wi-Fi, a SDIO function on sdhc2
 * (0x16460000; the vendor's "mmc1", SDR104 SDIO card). The vendor DT
 * (mobis/tcc8031-android-avn.dtsi) has this host as 4-bit, 50 MHz, pinctrl
 * sd2_{clk,cmd,bus4}/out0_clk (out0_clk supplies the chip's 32 kHz sleep clock; left as
 * the vendor kernel set it up). WL_REG_ON is gpa 24 (the vendor log prints
 * wifi_reg_on_port=24). Firmware: brcm/brcmfmac4359-sdio.{bin,txt,clm_blob}
 * from the vendor's fw_bcmdhd.bin, bcmdhd.cal and 89359.clm_blob. No
 * vmmc/vqmmc regulators are modeled, so signalling stays at 3.3 V
 * (high-speed 50 MHz); the vendor kernel runs SDR104 at 1.8 V.
 */
/ {
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&pinctrl 24 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <20>;
		power-off-delay-us = <10000>;
	};
};

&sdhc2 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	max-frequency = <50000000>;
	non-removable;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&wifi_pwrseq>;

	wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

/*
 * Audio out of the SoC: stereo I2S on audio block 3 (pads gpe-11/12/13:
 * BCLK, LRCK, DAO0; vendor mobis/tcc8031-pinctrl.dtsi:2182-2212) and the
 * 7.1ch block 0 (gpc-20..28), to whatever the amplifier path is. The vendor
 * DT has no codec on either: every dai-link there has a dummy codec, and no
 * mute/enable GPIO or amplifier I2C device appears in the kernel or its DT,
 * so unmuting the stock amplifier is not understood (see the audio notes).
 *
 * DISABLED. Enabling this turns on the SMC-driven clock provider and the
 * I2S/ADMA registers; none of it has run on hardware. Do it in this order:
 * 1. &sipclk alone (telechips,read-only stays on): only SMC state queries.
 * 2. add &i2s3 and &sound_i2s3: probe writes only the pads'
 *    function-select (gpe-11/12/13, function 2, as the stock kernel does);
 *    the first startup (aplay) writes the DAI and ADMA registers.
 * 3. drop telechips,read-only from &sipclk to let the driver set rates.
 */
&i2s3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s3_grp>;
};

/ {
	i2s_dit: audio-codec {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
		status = "disabled";
	};

	sound_i2s3: sound-i2s3 {
		compatible = "simple-audio-card";
		simple-audio-card,name = "tcc803x-i2s3";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&sound_i2s3_cpu>;
		simple-audio-card,frame-master = <&sound_i2s3_cpu>;
		status = "disabled";

		sound_i2s3_cpu: simple-audio-card,cpu {
			sound-dai = <&i2s3>;
		};

		simple-audio-card,codec {
			sound-dai = <&i2s_dit>;
		};
	};
};
