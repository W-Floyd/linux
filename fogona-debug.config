# Debug-only fragment. Apply ON TOP of fogona.config for diagnosis builds; do
# not fold these into the normal config.
#
# Built for the EROFS lookup hang: any path lookup on the vendor partition
# wedges unkillably, and every stack captured so far has been a
# d_alloc_parallel *waiter* piled up behind whoever wedged first. The task that
# actually holds DCACHE_PAR_LOOKUP is the one worth seeing, and these make the
# kernel volunteer it instead of us racing to catch it.

# erofs's own consistency checks. Note this makes DBG_BUGON live, so an
# unexpected condition panics with a backtrace rather than hanging silently --
# for this purpose a panic is the better outcome.
CONFIG_EROFS_FS_DEBUG=y

# Dumps the stack of any task blocked in D state past
# kernel.hung_task_timeout_secs. This is what should print the erofs stack
# unprompted. 30 s rather than the default 120: the boot-time stall this is
# for happens at ~15 s, before any sysctl.d could lower it at runtime, and a
# stack on the framebuffer within half a minute is what makes a stall that
# otherwise needs a power cycle diagnosable from the screen alone.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30

# The wedged `ls` was observed in R state with wchan 0, i.e. spinning rather
# than sleeping, which the hung-task detector will not catch. This will.
CONFIG_SOFTLOCKUP_DETECTOR=y

# So erofs's pr_debug() can be switched on at runtime through
# /sys/kernel/debug/dynamic_debug/control without another rebuild.
CONFIG_DYNAMIC_DEBUG=y

# RPM's per-master sleep records in message RAM (modem shutdown/bringup
# handshakes, XO accounting), for the RF-init stall: is the modem's remote
# power vote waiting on a sleep transition RPM never sees? Message RAM must
# not be read from user space on this SoC (TRAPS.md), so this is a module.
CONFIG_QCOM_RPM_MASTER_STATS=m

# Writable clk debugfs (clk_prepare_enable, clk_rate, parent): lets the AP
# make an RPM clock-buffer request by hand -- `echo 1 >
# /sys/kernel/debug/clk/ln_bb_clk3/clk_prepare_enable` -- to see whether RPM
# applies it (PMIC 0x5346 flips) or the request times out. Upstream refuses a
# Kconfig for this on purpose; ours lives only in this fragment.
CONFIG_COMMON_CLK_DEBUGFS_WRITE=y
