# Debug-only fragment. Apply ON TOP of fogona.config for diagnosis builds; do
# not fold these into the normal config.
#
# Built for the EROFS lookup hang: any path lookup on the vendor partition
# wedges unkillably, and every stack captured so far has been a
# d_alloc_parallel *waiter* piled up behind whoever wedged first. The task that
# actually holds DCACHE_PAR_LOOKUP is the one worth seeing, and these make the
# kernel volunteer it instead of us racing to catch it.

# erofs's own consistency checks. Note this makes DBG_BUGON live, so an
# unexpected condition panics with a backtrace rather than hanging silently --
# for this purpose a panic is the better outcome.
CONFIG_EROFS_FS_DEBUG=y

# Dumps the stack of any task blocked in D state past
# kernel.hung_task_timeout_secs (tunable at runtime; default 120, worth
# dropping to ~30). This is what should print the erofs stack unprompted.
CONFIG_DETECT_HUNG_TASK=y

# The wedged `ls` was observed in R state with wchan 0, i.e. spinning rather
# than sleeping, which the hung-task detector will not catch. This will.
CONFIG_SOFTLOCKUP_DETECTOR=y

# So erofs's pr_debug() can be switched on at runtime through
# /sys/kernel/debug/dynamic_debug/control without another rebuild.
CONFIG_DYNAMIC_DEBUG=y
