# fogona: pmOS conveniences, opt-in. Split out of fogona.config on 2026-09-11.
#
# Nothing here is needed to bring the board up. The working 6.14 build has none
# of it applied and still boots, drives the panel, runs phosh and serves SSH
# over usb0. Keeping it out of the base fragment means the default invocation
# of tools/fogona-config.sh produces a config that matches the known-good
# build, instead of one 20-odd symbols larger that nobody has booted.
#
# Apply with:  tools/fogona-config.sh <srcdir> --extra
#
# Cost, measured on the 7.3 tree when this set was applied by accident:
#   Image                 47,172,096 -> 52,865,536
#   chipone_icnl9916.ko       22,704 ->    527,312   (all DWARF5)
#
# Symbols the base fragment keeps despite sitting in these blocks, because the
# working build has them in some form and they change what the device can do:
# IPV6, NF_CONNTRACK, CRYPTO_CBC, CRYPTO_XTS, BLK_DEV_DM.

# Two systemd units failed on the first phosh boot, both for want of kernel
# support rather than anything device-specific:
#   postmarketos-zram-swap.service  -> CONFIG_ZRAM
#   nftables.service                -> CONFIG_NF_TABLES
# Neither is in `pmbootstrap kconfig check`'s required set, so the check passes
# without them -- the evidence was the failing units, not the checker. The
# units fail without these; nothing else does.
CONFIG_ZRAM=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
# NFT_REJECT is capped at m while IPV6=m -- see the trap note in fogona.config,
# which keeps IPV6=y in the base fragment precisely so this can work when
# applied.

# The rest of `pmbootstrap kconfig check`. Everything here must be =y, not =m:
# we boot a single Image with no matching modules on disk, so a module is the
# same as absent -- which is exactly the trap that hid the UFS and USB phys.
CONFIG_NLS_ASCII=y
CONFIG_SYN_COOKIES=y
CONFIG_UEVENT_HELPER=y
CONFIG_NULL_TTY=y
CONFIG_PSI=y
CONFIG_UDMABUF=y
CONFIG_SECURITY_PATH=y
CONFIG_BPF_LSM=y
# DM_CRYPT is capped by BLK_DEV_DM, which the base fragment sets =y for
# msm-firmware-loader's dm-linear anyway.
CONFIG_DM_CRYPT=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_REDUCED is not set
#
# Deliberately NOT taken, even here: CONFIG_DEBUG_INFO_BTF / _BTF_MODULES.
# They need pahole and add a large chunk of build time to every iteration,
# which is the wrong trade while the loop is still the bottleneck. Revisit
# before any upstreaming or if bpftrace is wanted on-device.
