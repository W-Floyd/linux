# fogona: pmOS userspace conveniences, NOT required to boot.
#
# Split out of fogona.config. Everything here is wanted for a shipping pmOS
# kernel -- zram swap, nftables, the rest of `pmbootstrap kconfig check`, and
# tracing -- but none of it is load-bearing for bringup: the working 6.14 tree
# boots fine without every symbol in this file. Applying it costs ~5.6 MB of
# Image and inflates every module ~20x (DEBUG_INFO_DWARF5 alone took
# chipone_icnl9916.ko from 22 KB to 527 KB).
#
# Apply with: tools/fogona-config.sh --extra
# Leave it off while bringing a kernel up, so it differs from a known-good
# config only in ways you chose.

CONFIG_ZRAM=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NLS_ASCII=y
CONFIG_SYN_COOKIES=y
CONFIG_UEVENT_HELPER=y
CONFIG_NULL_TTY=y
CONFIG_PSI=y
CONFIG_UDMABUF=y
CONFIG_SECURITY_PATH=y
CONFIG_BPF_LSM=y
CONFIG_DM_CRYPT=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_DEBUG_INFO_DWARF5=y
